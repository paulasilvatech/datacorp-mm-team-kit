    2 HR-INSERT                    (N6)
    2 USR-INSERT                   (A8)
    2 DT-LAST-UPDATE               (N8)
    2 HR-LAST-UPDATE               (N6)
    2 USR-LAST-UPDATE              (A8)
  1 AUDIT-V
    2 NUM-AUDIT                    (N15)
    2 DT-EVENT                     (N8)
    2 HR-EVENT                     (N6)
    2 TS-EVENT                     (N14)
    2 NUM-TRANSACTION              (A8)
    2 COD-ACTION                   (A2)
    2 COD-MODULE                   (A8)
    2 DESCR-ACTION                 (A80)
    2 TYPE-ENTITY                  (A4)
    2 ID-ENTITY                    (A15)
