    2 COD-REASON-BLOCK             (A2)
    2 IND-JUDICIAL                 (A1)
    2 NUM-CASE                     (A20)
    2 COD-PAYER-AGENCY             (N5)
    2 IND-LEGAL-REPRESENTATIVE     (A1)
    2 CPF-REPRESENTATIVE           (A11)
  1 PAYMENT-V
    2 NUM-PAYMENT                  (N15)
    2 NUM-CPF                      (A11)
    2 NUM-REGISTRATION             (N11)
    2 COD-PROGRAM                  (A4)
    2 YEAR-MONTH-REF               (N6)
    2 NUM-CYCLE                    (N6)
    2 AMT-GROSS                    (P9.2)
    2 AMT-NET                      (P9.2)
    2 AMT-DISC-TOTAL               (P7.2)
    2 AMT-BONUS                    (P9.2)
    2 TYPE-DISC                    (A3/1:8)
    2 AMT-DISC                     (P7.2/1:8)
    2 PCT-DISC                     (P3.2/1:8)
    2 NUM-CASE                     (A20/1:8)
    2 DT-START-DISC                (N8/1:8)
    2 DT-END-DISC                  (N8/1:8)
    2 STAT-PAYMENT                 (A1)
    2 DT-GENERATION                (N8)
    2 HR-GENERATION                (N6)
    2 DT-ISSUE                     (N8)
    2 DT-CONFIRMATION              (N8)
    2 DT-CANCELLATION              (N8)
    2 REASON-CANCELLATION          (A3)
    2 COD-BANK                     (A3)
    2 COD-BRANCH                   (A6)
    2 NUM-ACCOUNT                  (A13)
    2 TYPE-ACCOUNT                 (A1)
