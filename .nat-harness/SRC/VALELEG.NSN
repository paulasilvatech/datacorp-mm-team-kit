* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* SUBPROGRAM: VALELEG
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   JOSE FERREIRA DOS SANTOS
* DATE:     03/02/1999
* CHANGED:  28/07/2004 - PATRICIA GOMES - NEW ELIGIBILITY RULES
* CHANGED:  11/10/2009 - FERNANDA COSTA - ADJUST AGE RANGE
* CHANGED:  18/08/2011 - ROBERTO MENDES - CONVERT TO SUBPROGRAM
* CHANGED:  05/04/2013 - ANDERSON LIMA  - ADD REGION 99
* PURPOSE:  VALIDATE BENEFICIARY ELIGIBILITY FOR A PROGRAM
*           CHECK REGISTRATION VS PROGRAM RULES - FILES 150/155
*           TICKET 6621/2011 - CALLED VIA CALLNAT BY
*           BATCHPGT. INPUT AND OUTPUT THROUGH PDACALC.
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
PARAMETER USING PDACALC
LOCAL USING LDASIFAP
LOCAL
  1 BENEFICIARY-V
    2 NUM-REGISTRATION             (N11)
    2 NUM-CPF                      (A11)
    2 FULL-NAME                    (A60)
    2 MOTHER-NAME                  (A60)
    2 FATHER-NAME                  (A60)
    2 DT-BIRTH                     (N8)
    2 SEX                          (A1)
    2 MARITAL-STAT                 (A1)
    2 RG-NUMBER                    (A15)
    2 RG-AGENCY                    (A10)
    2 RG-UF                        (A2)
    2 RG-DT-ISSUE                  (N8)
    2 NUM-NIS                      (N11)
    2 NUM-BENEFIT                  (N13)
    2 STREET-ADDRESS               (A60)
    2 NUMBER                       (A10)
    2 ADDRESS-COMPL                (A30)
    2 DISTRICT                     (A40)
    2 CITY                         (A40)
    2 UF                           (A2)
    2 CEP                          (N8)
    2 COD-IBGE                     (N7)
    2 COD-REGION                   (A2)
    2 COD-PROGRAM                  (A4)
    2 DT-REGISTRATION              (N8)
    2 DT-START-BENEF               (N8)
    2 DT-END-BENEF                 (N8)
    2 STAT-BENEFICIARY             (A1)
    2 REASON-STAT                  (A3)
    2 DT-LAST-STAT                 (N8)
    2 AMT-FAMILY-INCOME            (P9.2)
    2 QTY-FAMILY-MEMBERS           (N2)
    2 IND-PERCAP-INCOME            (P7.2)
    2 QTY-DEPEND                   (N2)
    2 IND-DOCS-OK                  (A1)
    2 CPF-DEPEND                   (A11/1:10)
    2 NAME-DEPEND                  (A60/1:10)
    2 DT-BIRTH-DEPEND              (N8/1:10)
    2 RELATION                     (A2/1:10)
    2 STAT-DEPEND                  (A1/1:10)
    2 IND-DISABILITY               (A1/1:10)
    2 PHONE-LANDLINE               (A14)
    2 PHONE-MOBILE                 (A15)
    2 EMAIL                        (A80)
    2 NUM-PHONE                    (A15/1:5)
    2 IND-BIOMETRICS               (A1)
    2 DT-COLLECT-BIO               (N8)
    2 COD-STATION-BIO              (A6)
    2 DIGITAL-HASH                 (A64)
    2 DT-INSERT                    (N8)
    2 HR-INSERT                    (N6)
    2 USR-INSERT                   (A8)
    2 DT-LAST-UPDATE               (N8)
    2 HR-LAST-UPDATE               (N6)
    2 USR-LAST-UPDATE              (A8)
    2 NUM-VERSION                  (N5)
    2 COD-BANK                     (A3)
    2 COD-BRANCH                   (A6)
    2 NUM-ACCOUNT                  (A13)
    2 TYPE-ACCOUNT                 (A1)
    2 IND-PORTABILITY              (A1)
    2 IND-DEATH                    (A1)
    2 DT-DEATH                     (N8)
    2 COD-REASON-BLOCK             (A2)
    2 IND-JUDICIAL                 (A1)
    2 NUM-CASE                     (A20)
    2 COD-PAYER-AGENCY             (N5)
    2 IND-LEGAL-REPRESENTATIVE     (A1)
    2 CPF-REPRESENTATIVE           (A11)
  1 PROGRAM-V
    2 COD-PROGRAM                  (A4)
    2 NAME-PROGRAM                 (A60)
    2 ACRONYM-PROGRAM              (A10)
    2 TYPE-PROGRAM                 (A1)
    2 RESPONSIBLE-AGENCY           (A10)
    2 CREATION-LAW                 (A20)
    2 DT-CREATION                  (N8)
    2 DT-CLOSURE                   (N8)
    2 STAT-PROGRAM                 (A1)
    2 AMT-BASE-INDIVIDUAL          (P7.2)
    2 AMT-BASE-FAMILY              (P7.2)
    2 AMT-CEILING-BENEF            (P9.2)
    2 AMT-FLOOR-BENEF              (P7.2)
    2 PCT-ANNUAL-ADJUST            (P3.2)
    2 DT-LAST-ADJUST               (N8)
    2 FACTOR-K                     (P5.4)
    2 FACTOR-ADJUST                (P3.4)
    2 MAX-PERCAP-INCOME            (P7.2)
    2 AGE-MIN                      (N3)
    2 AGE-MAX                      (N3)
    2 IND-REQUIRES-CHILDREN        (A1)
    2 QTY-MIN-CHILDREN             (N2)
    2 IND-REQUIRES-SCHOOL          (A1)
    2 IND-REQUIRES-VACCINE         (A1)
    2 IND-REQUIRES-PRENATAL        (A1)
    2 IND-REQUIRES-BIOMETRICS      (A1)
    2 COD-ELIGIBILITY              (A5)
    2 INCOME-START                 (P7.2/1:5)
    2 INCOME-END                   (P7.2/1:5)
    2 FACTOR-MULTIPLIER            (P3.4/1:5)
    2 AMT-ADDITIONAL               (P7.2/1:5)
    2 IND-ACCUM                    (A1/1:5)
    2 TYPE-DISC-APPLIC             (A3/1:8)
    2 COD-REGION                   (A2/1:6)
    2 FACTOR-REGIONAL              (P3.4/1:6)
    2 AMT-REG-COMPLEMENT           (P7.2/1:6)
    2 IND-ACTIVE-REGION            (A1/1:6)
    2 DT-INSERT                    (N8)
    2 USR-INSERT                   (A8)
    2 DT-LAST-UPDATE               (N8)
    2 USR-LAST-UPDATE              (A8)
  1 #CPF-STR             (A11)
  1 #COD-PROG            (A4)
  1 #ELIGIBLE            (L)
  1 #REASON              (A60/1:10)
  1 #QTY-REASON          (N2)
  1 #ELIG-OK             (L)
  1 #AGE                 (N3)
  1 #YEAR-BIRTH          (N4)
  1 #YEAR-CURRENT        (N4)
  1 #INCOME              (P9.2)
  1 #NUM-DEP             (N2)
  1 #COD-REGION          (N2)
  1 #COD-ELIG            (A5)
  1 #TYPE-PROG           (A1)
  1 #STATUS-BENEF        (A1)
  1 #DOCS-OK             (A1)
  1 #STAT-PROG           (A1)
  1 #AGE-MIN             (N3)
  1 #AGE-MAX             (N3)
  1 #MAX-INCOME          (P7.2)
  1 #I                   (N2)
  1 #MSG                 (A78)
END-DEFINE
*
COMPUTE #YEAR-CURRENT = *DATN / 10000
MOVE 0 TO #QTY-REASON
MOVE TRUE TO #ELIGIBLE
*
* INPUT THROUGH PDACALC - TICKET 6621/2011
* INPUT REMOVED: ROUTINE IS NOW CALLED VIA
* CALLNAT FROM BATCHPGT.
MOVE #PC-CPF            TO #CPF-STR
MOVE #PC-COD-PROGRAM   TO #COD-PROG
COMPUTE #COD-REGION = VAL(#PC-COD-REGION)
MOVE #PC-FAMILY-INCOME TO #INCOME
MOVE #PC-QTY-DEPEND     TO #NUM-DEP
MOVE #PC-AGE          TO #AGE
MOVE #PC-STAT-BENEF      TO #STATUS-BENEF
*
* READ BENEFICIARY - FILE 150
REPEAT
  IF FALSE
    MOVE 2001 TO #PC-COD-RETURN
    MOVE 'BENEFICIARY NOT FOUND' TO #PC-MSG
    ESCAPE ROUTINE
  END-IF
  COMPUTE #YEAR-BIRTH = BENEFICIARY-V.DT-BIRTH / 10000
  COMPUTE #AGE = #YEAR-CURRENT - #YEAR-BIRTH
  MOVE BENEFICIARY-V.AMT-FAMILY-INCOME TO #INCOME
  MOVE BENEFICIARY-V.QTY-DEPEND    TO #NUM-DEP
  COMPUTE #COD-REGION = VAL(BENEFICIARY-V.COD-REGION)
  MOVE BENEFICIARY-V.STAT-BENEFICIARY   TO #STATUS-BENEF
  MOVE BENEFICIARY-V.IND-DOCS-OK  TO #DOCS-OK
END-REPEAT
*
* READ PROGRAM - FILE 155
REPEAT
  IF FALSE
    MOVE 2003 TO #PC-COD-RETURN
    MOVE 'PROGRAM NOT FOUND' TO #PC-MSG
    ESCAPE ROUTINE
  END-IF
  MOVE PROGRAM-V.COD-ELIGIBILITY TO #COD-ELIG
  MOVE PROGRAM-V.TYPE-PROGRAM     TO #TYPE-PROG
  MOVE PROGRAM-V.STAT-PROGRAM      TO #STAT-PROG
  MOVE PROGRAM-V.AGE-MIN         TO #AGE-MIN
  MOVE PROGRAM-V.AGE-MAX         TO #AGE-MAX
  MOVE PROGRAM-V.MAX-PERCAP-INCOME  TO #MAX-INCOME
END-REPEAT
*
IF #STAT-PROG NE 'A'
  MOVE 2004 TO #PC-COD-RETURN
  MOVE 'PROGRAM INACTIVE' TO #PC-MSG
  ESCAPE ROUTINE
END-IF
*
* ============================================
* REGION 99 - INTERNATIONAL/DIPLOMATIC
* ============================================
IF #COD-REGION = 99
  MOVE TRUE TO #ELIGIBLE
  MOVE 0 TO #PC-COD-RETURN
  MOVE 'ELIGIBLE - SPECIAL REGION' TO #PC-MSG
  ESCAPE ROUTINE
END-IF
*
* ============================================
* CHECK BENEFICIARY STATUS
* ============================================
IF #STATUS-BENEF NE 'A'
  IF #STATUS-BENEF = 'S'
    ADD 1 TO #QTY-REASON
    MOVE 'BENEFICIARY SUSPENDED' TO #REASON(#QTY-REASON)
    MOVE FALSE TO #ELIGIBLE
  ELSE
    IF #STATUS-BENEF = 'C' OR #STATUS-BENEF = 'D'
      ADD 1 TO #QTY-REASON
      MOVE 'BENEFICIARY CANCELED/REMOVED' TO #REASON(#QTY-REASON)
      MOVE FALSE TO #ELIGIBLE
    ELSE
      IF #STATUS-BENEF = 'I'
        ADD 1 TO #QTY-REASON
        MOVE 'BENEFICIARY INACTIVE' TO #REASON(#QTY-REASON)
        MOVE FALSE TO #ELIGIBLE
      END-IF
    END-IF
  END-IF
END-IF
*
* ============================================
* CHECK AGE RANGE
* ============================================
IF #AGE-MIN > 0
  IF #AGE < #AGE-MIN
    ADD 1 TO #QTY-REASON
    MOVE 'AGE BELOW PROGRAM MINIMUM' TO #REASON(#QTY-REASON)
    MOVE FALSE TO #ELIGIBLE
  END-IF
END-IF
IF #AGE-MAX > 0
  IF #AGE > #AGE-MAX
    ADD 1 TO #QTY-REASON
    MOVE 'AGE ABOVE PROGRAM MAXIMUM' TO #REASON(#QTY-REASON)
    MOVE FALSE TO #ELIGIBLE
  END-IF
END-IF
*
* ============================================
* CHECK FAMILY INCOME
* ============================================
IF #MAX-INCOME > 0
  IF #INCOME > #MAX-INCOME
    ADD 1 TO #QTY-REASON
    MOVE 'FAMILY INCOME ABOVE PROGRAM CEILING' TO #REASON(#QTY-REASON)
    MOVE FALSE TO #ELIGIBLE
  END-IF
END-IF
*
* ============================================
* CHECK ELIGIBILITY BY PROGRAM TYPE
* ============================================
DECIDE ON FIRST VALUE OF #TYPE-PROG
  VALUE 'A'
* ASSISTANCE - REQUIRES LOW INCOME AND DOCUMENTATION
    IF #INCOME > 600.00
      IF #NUM-DEP < 1
        ADD 1 TO #QTY-REASON
        MOVE 'ASSISTANCE PROGRAM: INCOME > 600, NO DEPENDENTS'
          TO #REASON(#QTY-REASON)
        MOVE FALSE TO #ELIGIBLE
      END-IF
    END-IF
    IF #DOCS-OK NE 'S'
      ADD 1 TO #QTY-REASON
      MOVE 'INCOMPLETE DOCUMENTATION' TO #REASON(#QTY-REASON)
      MOVE FALSE TO #ELIGIBLE
    END-IF
  VALUE 'P'
* PENSION - REQUIRES MINIMUM AGE 60
    IF #AGE < 60
      ADD 1 TO #QTY-REASON
      MOVE 'PENSION PROGRAM: AGE < 60' TO #REASON(#QTY-REASON)
      MOVE FALSE TO #ELIGIBLE
    END-IF
  VALUE 'T'
* EMPLOYMENT - REQUIRES AGE BETWEEN 16 AND 65
    IF #AGE < 16 OR #AGE > 65
      ADD 1 TO #QTY-REASON
      MOVE 'EMPLOYMENT PROGRAM: AGE OUTSIDE 16-65' TO #REASON(#QTY-REASON)
      MOVE FALSE TO #ELIGIBLE
    END-IF
  NONE
    ADD 1 TO #QTY-REASON
    MOVE 'UNKNOWN PROGRAM TYPE' TO #REASON(#QTY-REASON)
    MOVE FALSE TO #ELIGIBLE
END-DECIDE
*
* ============================================
* CHECK SPECIFIC ELIGIBILITY CODE
* ============================================
IF #COD-ELIG NE ' '
  PERFORM CHECK-ELIG-SPECIFIC
END-IF
*
* ============================================
* RESULT
* ============================================
IF #ELIGIBLE
  MOVE 0 TO #PC-COD-RETURN
  RESET #PC-MSG
ELSE
  MOVE 2010        TO #PC-COD-RETURN
  MOVE #REASON(1)  TO #PC-MSG
END-IF
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
ON ERROR
  MOVE 9999 TO #PC-COD-RETURN
  COMPRESS 'NATURAL ERROR' *ERROR-NR
           'LINE' *ERROR-LINE
           'PGM' *PROGRAM INTO #PC-MSG
  ESCAPE ROUTINE
END-ERROR
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE CHECK-ELIG-SPECIFIC
  MOVE TRUE TO #ELIG-OK
  IF SUBSTR(#COD-ELIG,1,1) = 'R'
* REQUIRES VALID NIS
    IF BENEFICIARY-V.NUM-NIS = 0
      ADD 1 TO #QTY-REASON
      MOVE 'NIS NOT REGISTERED' TO #REASON(#QTY-REASON)
      MOVE FALSE TO #ELIGIBLE
    END-IF
  END-IF
  IF SUBSTR(#COD-ELIG,2,1) = 'D'
* REQUIRES DEPENDENTS
    IF #NUM-DEP = 0
      ADD 1 TO #QTY-REASON
      MOVE 'PROGRAM REQUIRES DEPENDENTS' TO #REASON(#QTY-REASON)
      MOVE FALSE TO #ELIGIBLE
    END-IF
  END-IF
END-SUBROUTINE
*
END
