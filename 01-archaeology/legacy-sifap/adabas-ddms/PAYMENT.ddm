 T L DB Name                     F Leng  S D Remark
 - - -- ------------------------ - ----  - - ---------------------------
*
* --- KEYS ---
*
   1 AA NUM-PAGAMENTO            N   15    U UNIQUE SEQUENCE
   1 AB NUM-CPF                  A   11    D BENEFICIARY CPF
   1 AC NUM-INSCRICAO            N   11  N   BENEFICIARY REGISTRATION
   1 AD COD-PROGRAMA             A    4    D SOCIAL PROGRAM
   1 AE ANO-MES-REF              N    6    D YYYYMM - REFERENCE PERIOD
   1 AF NUM-CICLO                N    6    D PROCESSING CYCLE
*
* --- AMOUNTS ---
*
   1 BA VLR-BRUTO                P  9,2      CALCULATED GROSS AMOUNT
   1 BB VLR-LIQUIDO              P  9,2      NET AMOUNT (GROSS-DISCOUNT)
   1 BC VLR-DESCONTO-TOTAL       P  7,2  N   SUM OF DISCOUNTS
   1 BD VLR-ABONO                P  9,2  N   ALLOWANCE (ADDED 2001)
*
* --- ITEMIZED DISCOUNTS (PERIODIC GROUP - MAX. 8 TYPES) ---
*
 P 1 CA GRP-DESCONTO                         (1:8) APPLIED DISCOUNTS
   2 CB TIPO-DESCONTO            A    3  N   IR/JD/CS/PA/EM/TX/OU/EX
   2 CC VLR-DESCONTO             P  7,2  N   DISCOUNT AMOUNT
   2 CD PCT-DESCONTO             P  3,2  N   APPLIED PERCENTAGE
   2 CE NUM-PROCESSO             A   20  N   COURT CASE NO. (IF JD)
   2 CF DT-INICIO-DSCT           N    8  N   YYYYMMDD
   2 CG DT-FIM-DSCT              N    8  N   YYYYMMDD (0=UNDEFINED)
*
* --- STATUS AND PROCESSING ---
*
   1 DA SIT-PAGAMENTO            A    1  F D P=PENDING G=GENERATED E=ISSUED
*                                             C=CONFIRMED D=RETURNED
*                                             X=CANCELED R=REPROCESSED
   1 DB DT-GERACAO               N    8    D YYYYMMDD - BATCH GENERATION
   1 DC HR-GERACAO               N    6      HHMMSS
   1 DD DT-EMISSAO               N    8  N   YYYYMMDD - SENT TO BANK
   1 DE DT-CONFIRMACAO           N    8  N   YYYYMMDD - BANK RESPONSE
   1 DF DT-CANCELAMENTO          N    8  N   YYYYMMDD (IF APPLICABLE)
   1 DG MOT-CANCELAMENTO         A    3  N   REASON CODE (INTERNAL TABLE)
*
* --- BANKING DATA ---
*
   1 EA COD-BANCO                A    3  N D FEBRABAN CODE
   1 EB COD-AGENCIA              A    6  N   BRANCH NUMBER
   1 EC NUM-CONTA                A   13  N   ACCOUNT NUMBER
   1 ED TIPO-CONTA               A    1  F   C=CHECKING P=SAVINGS
   1 EE COD-OPERACAO             A    3  N   CAIXA OPERATION (IF APPLICABLE)
   1 EF DT-CREDITO               N    8  N D YYYYMMDD - ACCOUNT CREDIT
*                                             (ADDED 1999 - NOT DB)
   1 EG TIPO-PAGAMENTO           A    1  F D N=NORMAL R=RETROACTIVE
*                                             A=ALLOWANCE C=CORRECTION
*
* --- SIAFI INTEGRATION (ADDED 2002) ---
*
   1 FA NUM-OB-SIAFI             A   12  N   SIAFI BANK ORDER
   1 FB NUM-NE-SIAFI             A   12  N   SIAFI COMMITMENT NOTE
   1 FC COD-UG-EMITENTE          A    6  N   MANAGEMENT UNIT
   1 FD COD-GESTAO               A    5  N   SIAFI MANAGEMENT CODE
   1 FE SIT-INTEG-SIAFI          A    1  F   I=INTEGRATED P=PENDING E=ERROR
   1 FF NUM-LOTE                 N    8    D REMITTANCE BATCH (1999)
   1 FG SEQ-LOTE                 N    6      SEQUENCE WITHIN BATCH
*
* --- BANK RECONCILIATION ---
*
   1 GA DT-CONCILIACAO           N    8  N   YYYYMMDD
   1 GB SIT-CONCILIACAO          A    1  F   C=RECONCILED D=DIVERGENT
*                                             P=PENDING N=N/A
   1 GC VLR-CONCILIADO           P  9,2  N   BANK-CONFIRMED AMOUNT
   1 GD COD-RETORNO-BANCO        A    2  N D CNAB 240 RETURN CODE
   1 GE DES-RETORNO-BANCO        A   40  N   RETURN DESCRIPTION
   1 GF DT-DEVOLUCAO             N    8  N   YYYYMMDD (ADDED 1999)
   1 GG IND-ESTORNO              A    1  F   S/N (ADDED 2003)
   1 GH NUM-PAGTO-ORIGEM         N   15  N D ORIGINAL PAYMENT (2003)
   1 GI VLR-CORRECAO             P  9,2  N   CORRECTION AMOUNT
   1 GJ DT-CORRECAO              N    8  N   YYYYMMDD
   1 GK IND-CORRIGIDO            A    1  F   S/N
*
* --- FILE HASH (ADDED 2015) ---
*
   1 HA HASH-ARQ-REMESSA         A   64  N   SHA-256 REMITTANCE FILE
   1 HB HASH-ARQ-RETORNO         A   64  N   SHA-256 RETURN FILE
 M 1 HC COD-OCORRENCIA           A    3  N   (1:10) BANK OCCURRENCES
*                                             (ADDED 2005)
*
* --- CONTROL ---
*
   1 IA DT-INCLUSAO              N    8      YYYYMMDD
   1 IB HR-INCLUSAO              N    6      HHMMSS
   1 IC USR-INCLUSAO             A    8  N   LOGIN - USUALLY 'BATCH'
   1 ID DT-ULT-ALTERACAO         N    8  N   YYYYMMDD
   1 IE HR-ULT-ALTERACAO         N    6  N   HHMMSS
   1 IF USR-ULT-ALTERACAO        A    8  N
