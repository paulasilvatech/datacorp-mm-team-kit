* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* PROGRAM: BATCHCON
* SYSTEM:  SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:  MARCOS ANTONIO RIBEIRO
* DATE:    05/03/2000
* CHANGED: 18/09/2005 - MARCOS RIBEIRO - ADD BANCO REAL
* CHANGED: 22/06/2008 - ROBERTO MENDES - ADJUST CNAB 240
* CHANGED: 30/01/2014 - ANDERSON LIMA  - ADD AUDITING
* CHANGED: 11/05/2017 - SIFAP TEAM     - ADD CCAUDIT/ON ERROR
* PURPOSE: PAYMENT RECONCILIATION AGAINST BANK RETURN
*          BANCO DO BRASIL CNAB 240 PROCESS
*          GENERATES AUDIT RECORDS - FILES 160/170
*
* JOB.....: NOT AUTOMATED - MANUAL EXECUTION THROUGH NATURAL
*           TICKET 8110/2017 - DEDICATED JCL REQUESTED
* INPUT...: CMWKF01 - CNAB 240 RETURN (LRECL 240)
* OUTPUT..: CMPRINT - EXECUTION LOG
* RETURN..: 0=OK  4=WITH DISCREPANCIES  12=NATURAL ERROR
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
LOCAL USING LDASIFAP
LOCAL
  1 PAGAMENTO-V VIEW OF PAGAMENTO
    2 NUM-PAGAMENTO      (N15)
    2 NUM-CPF            (A11)
    2 COD-PROGRAMA       (A4)
    2 ANO-MES-REF        (N6)
    2 VLR-BRUTO          (P9,2)
    2 VLR-LIQUIDO        (P9,2)
    2 SIT-PAGAMENTO      (A1)
    2 DT-GERACAO         (N8)
    2 DT-CREDITO         (N8)
    2 COD-BANCO          (A3)
    2 COD-RETORNO-BANCO  (A2)
*
  1 AUDITORIA-V VIEW OF AUDITORIA
    2 NUM-AUDITORIA      (N15)
    2 DT-EVENTO          (N8)
    2 HR-EVENTO          (N6)
    2 TS-EVENTO          (N14)
    2 COD-ACAO           (A2)
    2 COD-MODULO         (A8)
    2 DES-ACAO           (A80)
    2 TIPO-ENTIDADE      (A4)
    2 ID-ENTIDADE        (A15)
    2 NUM-CPF-AFETADO    (A11)
    2 USR-EVENTO         (A8)
    2 NOM-JOB-BATCH      (A16)
    2 SIT-BATCH          (A1)
    2 VLR-ANTERIOR       (A60)
    2 VLR-NOVO           (A60)
*
* CNAB 240 RECORD - BB LAYOUT
  1 #REG-CNAB            (A240)
  1 #CNAB-BANCO          (A3)
  1 #CNAB-LOTE           (A4)
  1 #CNAB-TIPO-REG       (A1)
  1 #CNAB-CPF            (A11)
  1 #CNAB-VLR            (A15)
  1 #CNAB-DT-PGTO        (A8)
  1 #CNAB-COD-RET        (A2)
  1 #CNAB-NUM-DOC        (A10)
*
  1 #COMPETENCIA         (N6)
  1 #COMPET-A            (A6)
  1 #DT-HOJE             (N8)
  1 #HR-ATUAL             (N6)
  1 #TIMN-AUX            (N7)
  1 #ARQ-RETORNO         (A60)
*
* COUNTERS
  1 #QTD-LIDOS           (N8)
  1 #QTD-CONCILIADOS     (N8)
  1 #QTD-DIVERGENTES     (N8)
  1 #QTD-NAO-ENCONTRADOS (N8)
  1 #QTD-AUDIT           (N8)
*
* WORK VARIABLES
  1 #CPF-NUM             (N11)
  1 #VLR-RETORNO         (P9,2)
  1 #VLR-STR             (A15)
  1 #VLR-CENT            (N15)
  1 #VLR-PGTO-SIFAP      (P9,2)
  1 #NUM-PGTO            (N15)
  1 #DT-PGTO             (N8)
  1 #COD-RET             (A2)
  1 #FOUND               (L)
  1 #SEQ-AUDIT           (N15)
  1 #MSG                 (A80)
  1 #DIFF                (P9,2)
  1 #I                   (N2)
  1 #VLR-ANT-STR         (A60)
  1 #VLR-NOV-STR         (A60)
*
* FIELDS REQUIRED BY COPYCODE CCAUDIT
  1 #AUD-ACAO            (A2)
  1 #AUD-ENTIDADE        (A4)
  1 #AUD-ID              (A15)
  1 #AUD-CPF             (A11)
  1 #AUD-DESCRICAO       (A80)
  1 #AUD-SEQ             (N15)
  1 #AUD-TIMN            (N7)
END-DEFINE
*
MOVE *DATN TO #DT-HOJE
* *TIMN RETURNS N7 (HHMMSST) - FILE 153 STORES N6
MOVE *TIMN TO #TIMN-AUX
DIVIDE 10 INTO #TIMN-AUX GIVING #HR-ATUAL
MOVE 0 TO #QTD-LIDOS
MOVE 0 TO #QTD-CONCILIADOS
MOVE 0 TO #QTD-DIVERGENTES
MOVE 0 TO #QTD-NAO-ENCONTRADOS
MOVE 0 TO #QTD-AUDIT
*
* GET LAST AUDIT SEQUENCE - LIMIT (1) AVOIDS ESCAPE
READ (1) AUDITORIA-V BY NUM-AUDITORIA DESCENDING
  MOVE AUDITORIA-V.NUM-AUDITORIA TO #SEQ-AUDIT
END-READ
*
INPUT 'SIFAP - BANK RECONCILIATION' /
      '=============================' /
      'PERIOD..........:' #COMPETENCIA /
      'RETURN FILE.....:' #ARQ-RETORNO
*
WRITE '================================================'
WRITE 'BATCHCON - PAYMENT RECONCILIATION'
WRITE 'PERIOD:' #COMPETENCIA
WRITE 'FILE:' #ARQ-RETORNO
WRITE '================================================'
*
* READ CNAB 240 RETURN FILE
* IN Z/OS THE BINDING USES DD CMWKF01 - THE NAME PROVIDED
* ABOVE IS FOR DOCUMENTATION ONLY - TICKET 8111/2017
MOVE EDITED #COMPETENCIA (EM=999999) TO #COMPET-A
READ WORK FILE 1 #REG-CNAB
*
  ADD 1 TO #QTD-LIDOS
*
* PARSE CNAB 240 RECORD
  MOVE SUBSTR(#REG-CNAB,1,3)     TO #CNAB-BANCO
  MOVE SUBSTR(#REG-CNAB,4,4)     TO #CNAB-LOTE
  MOVE SUBSTR(#REG-CNAB,8,1)     TO #CNAB-TIPO-REG
*
* PROCESS DETAIL RECORDS ONLY (TYPE=3)
  IF #CNAB-TIPO-REG NE '3'
    ESCAPE TOP
  END-IF
*
  MOVE SUBSTR(#REG-CNAB,44,11)   TO #CNAB-CPF
  MOVE SUBSTR(#REG-CNAB,120,15)  TO #CNAB-VLR
  MOVE SUBSTR(#REG-CNAB,140,8)   TO #CNAB-DT-PGTO
  MOVE SUBSTR(#REG-CNAB,231,2)   TO #CNAB-COD-RET
  MOVE SUBSTR(#REG-CNAB,74,10)   TO #CNAB-NUM-DOC
*
  MOVE #CNAB-CPF TO #CPF-NUM
  MOVE #CNAB-NUM-DOC TO #NUM-PGTO
*
* CONVERT AMOUNT (CENTS -> REAIS)
* UNTIL 2017 THE A15 WENT DIRECTLY TO THE DECIMAL FIELD
* TICKET 8112/2017
  MOVE #CNAB-VLR TO #VLR-STR
  MOVE #VLR-STR TO #VLR-CENT
  COMPUTE #VLR-RETORNO = #VLR-CENT / 100
*
  MOVE #CNAB-DT-PGTO TO #DT-PGTO
  MOVE #CNAB-COD-RET TO #COD-RET
*
* FIND MATCHING PAYMENT
  MOVE FALSE TO #FOUND
  RESET #VLR-PGTO-SIFAP
  FIND PAGAMENTO-V WITH NUM-PAGAMENTO = #NUM-PGTO
    IF PAGAMENTO-V.NUM-CPF = #CNAB-CPF
        AND PAGAMENTO-V.ANO-MES-REF = #COMPETENCIA
      MOVE TRUE TO #FOUND
      MOVE PAGAMENTO-V.VLR-LIQUIDO TO #VLR-PGTO-SIFAP
    END-IF
  END-FIND
*
  IF NOT #FOUND
    ADD 1 TO #QTD-NAO-ENCONTRADOS
    COMPRESS 'NOT FOUND: CPF=' #CNAB-CPF ' DOC=' #CNAB-NUM-DOC
        INTO #MSG
    WRITE #MSG
    ESCAPE TOP
  END-IF
*
* RECONCILE AMOUNTS
  COMPUTE #DIFF = #VLR-PGTO-SIFAP - #VLR-RETORNO
  IF #DIFF < 0
    COMPUTE #DIFF = #DIFF * -1
  END-IF
*
  IF #DIFF > 0.01
    ADD 1 TO #QTD-DIVERGENTES
    COMPRESS 'DISCREPANCY: CPF=' #CNAB-CPF
        ' SIFAP=' #VLR-PGTO-SIFAP
        ' BANK=' #VLR-RETORNO INTO #MSG
    WRITE #MSG
*
    PERFORM GRAVA-AUDITORIA-DIVERG
  ELSE
    ADD 1 TO #QTD-CONCILIADOS
* UPDATE PAYMENT STATUS
    DECIDE ON FIRST VALUE OF #COD-RET
      VALUE '00'
        FIND PAGAMENTO-V WITH NUM-PAGAMENTO = #NUM-PGTO
          MOVE 'P'     TO PAGAMENTO-V.SIT-PAGAMENTO
          MOVE #DT-PGTO TO PAGAMENTO-V.DT-CREDITO
          MOVE 1        TO PAGAMENTO-V.COD-BANCO
          MOVE #COD-RET TO PAGAMENTO-V.COD-RETORNO-BANCO
          UPDATE PAGAMENTO-V
          END TRANSACTION
        END-FIND
      VALUE '01'
        FIND PAGAMENTO-V WITH NUM-PAGAMENTO = #NUM-PGTO
          MOVE 'D'     TO PAGAMENTO-V.SIT-PAGAMENTO
          MOVE #COD-RET TO PAGAMENTO-V.COD-RETORNO-BANCO
          UPDATE PAGAMENTO-V
          END TRANSACTION
        END-FIND
      VALUE '02'
        FIND PAGAMENTO-V WITH NUM-PAGAMENTO = #NUM-PGTO
          MOVE 'E'     TO PAGAMENTO-V.SIT-PAGAMENTO
          MOVE #COD-RET TO PAGAMENTO-V.COD-RETORNO-BANCO
          UPDATE PAGAMENTO-V
          END TRANSACTION
        END-FIND
      NONE
        COMPRESS 'UNKNOWN RETURN CODE:' #COD-RET
            ' CPF=' #CNAB-CPF INTO #MSG
        WRITE #MSG
    END-DECIDE
*
    PERFORM GRAVA-AUDITORIA-CONC
  END-IF
*
END-WORK
*
* --------------------------------------------------------
* BANCO REAL INTEGRATION - DISCONTINUED
* BANCO REAL WAS ACQUIRED BY SANTANDER IN 2007
* KEEP CODE FOR HISTORICAL REFERENCE
* OWNER: MARCOS RIBEIRO - 18/09/2005
* --------------------------------------------------------
*  DEFINE WORK FILE 2 'RETORNO_REAL.DAT' TYPE 'ASCII'
*  READ WORK FILE 2 #REG-CNAB
*    MOVE SUBSTR(#REG-CNAB,1,3) TO #CNAB-BANCO
*    IF #CNAB-BANCO NE '356'   /* BANCO REAL CODE */
*      ESCAPE TOP
*    END-IF
*    MOVE SUBSTR(#REG-CNAB,30,14) TO #CNAB-CPF
*    MOVE SUBSTR(#REG-CNAB,100,13) TO #CNAB-VLR
*    /* BANCO REAL LAYOUT DIFFERS FROM BB */
*    /* AMOUNT AT POSITION 100-112, CPF AT 30-43 */
*    PERFORM CONCILIA-REAL
*  END-WORK
* --------------------------------------------------------
*
* SUMMARY
WRITE '================================================' /
      'BATCHCON - RECONCILIATION SUMMARY' /
      '================================================' /
      'RECORDS READ...........:' #QTD-LIDOS /
      'RECONCILED.............:' #QTD-CONCILIADOS /
      'DISCREPANCIES..........:' #QTD-DIVERGENTES /
      'NOT FOUND..............:' #QTD-NAO-ENCONTRADOS /
      'AUDIT RECORDS..........:' #QTD-AUDIT /
      '================================================'
*
* --------------------------------------------------------
* CYCLE AUDIT TRAIL - FILE 153
* IN-TCU 63/2010 - TICKET 8113/2017
* SEED INHERITED FROM #SEQ-AUDIT TO AVOID DUPLICATE KEY
* --------------------------------------------------------
MOVE #SEQ-AUDIT TO #AUD-SEQ
MOVE 'BT'       TO #AUD-ACAO
MOVE 'PGTO'     TO #AUD-ENTIDADE
MOVE #COMPET-A  TO #AUD-ID
RESET #AUD-CPF
COMPRESS 'RECONCILIATION PERIOD' #COMPET-A
    'READ' #QTD-LIDOS 'DISCREP' #QTD-DIVERGENTES
    INTO #AUD-DESCRICAO
PERFORM GRAVA-AUDITORIA
MOVE #AUD-SEQ TO #SEQ-AUDIT
END TRANSACTION
*
CLOSE WORK FILE 1
*
* RETURN CODE - TICKET 8114/2017
IF #QTD-DIVERGENTES > 0 OR #QTD-NAO-ENCONTRADOS > 0
  WRITE 'RECONCILIATION HAS PENDING ITEMS - CHECK LOG'
  TERMINATE 4
END-IF
TERMINATE 0
*
* --------------------------------------------------------
* NATURAL ERROR HANDLING - TICKET 8115/2017
* --------------------------------------------------------
ON ERROR
  WRITE 'NATURAL ERROR NO.:' *ERROR-NR
  WRITE 'LINE.............:' *ERROR-LINE
  WRITE 'PROGRAM..........:' *PROGRAM
  WRITE 'LAST CNAB DOC....:' #CNAB-NUM-DOC
  WRITE 'RECORDS READ.....:' #QTD-LIDOS
  BACKOUT TRANSACTION
  CLOSE WORK FILE 1
  TERMINATE 12
END-ERROR
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE GRAVA-AUDITORIA-CONC
  ADD 1 TO #SEQ-AUDIT
  ADD 1 TO #QTD-AUDIT
  MOVE #SEQ-AUDIT  TO AUDITORIA-V.NUM-AUDITORIA
  MOVE #DT-HOJE    TO AUDITORIA-V.DT-EVENTO
  MOVE #HR-ATUAL   TO AUDITORIA-V.HR-EVENTO
  MOVE 'BATCH'     TO AUDITORIA-V.USR-EVENTO
  MOVE 'CO'        TO AUDITORIA-V.COD-ACAO
  MOVE 'PGTO'      TO AUDITORIA-V.TIPO-ENTIDADE
  MOVE #NUM-PGTO   TO AUDITORIA-V.ID-ENTIDADE
  COMPRESS 'RECONCILED RETURN CODE=' #COD-RET INTO AUDITORIA-V.DES-ACAO
  STORE AUDITORIA-V
  END TRANSACTION
END-SUBROUTINE
*
DEFINE SUBROUTINE GRAVA-AUDITORIA-DIVERG
  ADD 1 TO #SEQ-AUDIT
  ADD 1 TO #QTD-AUDIT
  MOVE #SEQ-AUDIT  TO AUDITORIA-V.NUM-AUDITORIA
  MOVE #DT-HOJE    TO AUDITORIA-V.DT-EVENTO
  MOVE #HR-ATUAL   TO AUDITORIA-V.HR-EVENTO
  MOVE 'BATCH'     TO AUDITORIA-V.USR-EVENTO
  MOVE 'DV'        TO AUDITORIA-V.COD-ACAO
  MOVE 'PGTO'      TO AUDITORIA-V.TIPO-ENTIDADE
  MOVE #NUM-PGTO   TO AUDITORIA-V.ID-ENTIDADE
  MOVE #VLR-PGTO-SIFAP TO #VLR-ANT-STR
  MOVE #VLR-RETORNO TO #VLR-NOV-STR
  MOVE #VLR-ANT-STR TO AUDITORIA-V.VLR-ANTERIOR
  MOVE #VLR-NOV-STR TO AUDITORIA-V.VLR-NOVO
  COMPRESS 'SIFAP VS BANK AMOUNT DISCREPANCY' INTO AUDITORIA-V.DES-ACAO
  STORE AUDITORIA-V
  END TRANSACTION
END-SUBROUTINE
*
INCLUDE CCAUDIT
*
END
