* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* PROGRAM: BATCHREL
* SYSTEM:  SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:  PATRICIA GOMES DE SOUZA
* DATE:    10/11/1999
* CHANGED: 20/04/2006 - ROBERTO MENDES - ADD REGION SUBTOTALS
* CHANGED: 09/10/2006 - ROBERTO MENDES - CONTROL BREAK
* CHANGED: 14/02/2013 - ANDERSON LIMA  - ADJUST FORMAT
* CHANGED: 05/06/2014 - SIFAP TEAM     - COPY CMWKF01
* PURPOSE: GENERATE MONTHLY CONSOLIDATED REPORTS
*          SUMMARIZE BY REGION/PROGRAM/STATUS
*          FLAT-FILE OUTPUT FOR MAINFRAME PRINTING
*
* JOB.....: SIFAPJ02 - STEP010 - PGM=NATBATCH
* INPUT...: CMSYNIN - YYYYMM PERIOD
* OUTPUT..: CMPRT01 - PRINTED REPORT       (LRECL 133)
*           CMWKF01 - ARCHIVAL COPY        (LRECL 132)
*           CMPRINT - EXECUTION LOG
* RETURN..: 0=OK  4=NO ACTIVITY  12=NATURAL ERROR
* NOTE....: 10-YEAR RETENTION - LAW 8159 ART 14
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
LOCAL USING LDASIFAP
LOCAL
  1 PAGAMENTO-V VIEW OF PAGAMENTO
    2 NUM-PAGAMENTO      (N15)
    2 NUM-CPF            (A11)
    2 COD-PROGRAMA       (A4)
    2 ANO-MES-REF        (N6)
    2 VLR-BRUTO          (P9,2)
    2 VLR-DESCONTO-TOTAL (P7,2)
    2 VLR-LIQUIDO        (P9,2)
    2 SIT-PAGAMENTO      (A1)
    2 TIPO-PAGAMENTO     (A1)
    2 VLR-ABONO          (P9,2)
*
  1 BENEFICIARIO-V VIEW OF BENEFICIARIO
    2 NUM-CPF            (A11)
    2 COD-REGIAO         (A2)
    2 UF                 (A2)
*
  1 #COMPETENCIA         (N6)
  1 #DT-HOJE             (N8)
*
* ACCUMULATORS BY REGION (5 REGIONS)
  1 #TOT-REG-BRUTO       (P13,2/1:5)
  1 #TOT-REG-DESC        (P13,2/1:5)
  1 #TOT-REG-LIQ         (P13,2/1:5)
  1 #QTD-REG             (N8/1:5)
  1 #NOME-REG            (A15/1:5)
*
* ACCUMULATORS BY STATUS
  1 #TOT-STS-BRUTO       (P13,2/1:5)
  1 #QTD-STS             (N8/1:5)
  1 #NOME-STS            (A15/1:5)
*
* GRAND TOTALS
  1 #TOT-GERAL-BRUTO     (P15,2)
  1 #TOT-GERAL-DESC      (P15,2)
  1 #TOT-GERAL-LIQ       (P15,2)
  1 #QTD-GERAL            (N8)
*
* AUXILIARY VARIABLES
  1 #IDX-REG             (N2)
  1 #COD-REG             (N2)
  1 #STATUS              (A1)
  1 #IDX-STS             (N2)
  1 #I                   (N2)
  1 #FOUND               (L)
  1 #LINHA-REL           (A132)
  1 #PAG                 (N4)
  1 #LINHA               (N2)
  1 #MAX-LINHAS          (N2)
*
* REPORT ROUNDING
  1 #VLR-ARR             (P13,2)
  1 #VLR-TEMP            (N15)
END-DEFINE
*
* SIFAPJ02 LOGICAL PRINTER - DD CMPRT01
DEFINE PRINTER (1) OUTPUT 'CMPRT01'
FORMAT (1) PS=66 LS=132
*
MOVE *DATN TO #DT-HOJE
MOVE 66 TO #MAX-LINHAS  /* MAINFRAME PRINTER STANDARD */
MOVE 0 TO #PAG
MOVE 99 TO #LINHA  /* FORCE HEADER ON FIRST PAGE */
*
* REGION NAMES
MOVE 'NORTH' TO #NOME-REG(1)
MOVE 'NORTHEAST' TO #NOME-REG(2)
MOVE 'SOUTHEAST' TO #NOME-REG(3)
MOVE 'SOUTH' TO #NOME-REG(4)
MOVE 'CENTRAL-WEST' TO #NOME-REG(5)
*
* STATUS NAMES
MOVE 'GENERATED' TO #NOME-STS(1)
MOVE 'PAID' TO #NOME-STS(2)
MOVE 'CANCELED' TO #NOME-STS(3)
MOVE 'RETURNED' TO #NOME-STS(4)
MOVE 'REVERSED' TO #NOME-STS(5)
*
* INITIALIZE ACCUMULATORS
FOR #I = 1 TO 5
  MOVE 0 TO #TOT-REG-BRUTO(#I)
  MOVE 0 TO #TOT-REG-DESC(#I)
  MOVE 0 TO #TOT-REG-LIQ(#I)
  MOVE 0 TO #QTD-REG(#I)
  MOVE 0 TO #TOT-STS-BRUTO(#I)
  MOVE 0 TO #QTD-STS(#I)
END-FOR
MOVE 0 TO #TOT-GERAL-BRUTO
MOVE 0 TO #TOT-GERAL-DESC
MOVE 0 TO #TOT-GERAL-LIQ
MOVE 0 TO #QTD-GERAL
*
* PERIOD PROVIDED BY SIFAPJ02 CMSYNIN
INPUT 'REPORT PERIOD:' #COMPETENCIA
IF #COMPETENCIA = 0
  WRITE 'PERIOD NOT PROVIDED IN CMSYNIN'
  TERMINATE 12
END-IF
*
* PROCESSING - READ PAYMENTS
READ PAGAMENTO-V BY ANO-MES-REF = #COMPETENCIA
*
* CONTROL BREAK BY PERIOD - TICKET 3990/2006
  AT BREAK OF PAGAMENTO-V.ANO-MES-REF
    WRITE 'PERIOD BREAK - RECORDS READ SO FAR:' #QTD-GERAL
  END-BREAK
*
  AT END OF DATA
    WRITE 'END OF FILE - TOTAL READ:' #QTD-GERAL
  END-ENDDATA
*
  IF PAGAMENTO-V.ANO-MES-REF NE #COMPETENCIA
    ESCAPE BOTTOM
  END-IF
*
* FIND BENEFICIARY REGION
  MOVE 0 TO #COD-REG
  FIND BENEFICIARIO-V WITH NUM-CPF = PAGAMENTO-V.NUM-CPF
    MOVE BENEFICIARIO-V.COD-REGIAO TO #COD-REG
  END-FIND
*
* DETERMINE REGION INDEX
  IF #COD-REG >= 1 AND #COD-REG <= 5
    MOVE 1 TO #IDX-REG
  ELSE
    IF #COD-REG >= 6 AND #COD-REG <= 10
      MOVE 2 TO #IDX-REG
    ELSE
      IF #COD-REG >= 11 AND #COD-REG <= 15
        MOVE 3 TO #IDX-REG
      ELSE
        IF #COD-REG >= 16 AND #COD-REG <= 20
          MOVE 4 TO #IDX-REG
        ELSE
          MOVE 5 TO #IDX-REG
        END-IF
      END-IF
    END-IF
  END-IF
*
* ACCUMULATE BY REGION
* NOTE: ROUNDING DIFFERS FROM CALCBENF (ROUND VS TRUNCATE)
  COMPUTE #VLR-ARR = PAGAMENTO-V.VLR-BRUTO + 0.005
  COMPUTE #VLR-TEMP = #VLR-ARR * 100
  COMPUTE #VLR-ARR = #VLR-TEMP / 100
  ADD #VLR-ARR TO #TOT-REG-BRUTO(#IDX-REG)
  ADD PAGAMENTO-V.VLR-DESCONTO-TOTAL
      TO #TOT-REG-DESC(#IDX-REG)
  ADD PAGAMENTO-V.VLR-LIQUIDO  TO #TOT-REG-LIQ(#IDX-REG)
  ADD 1 TO #QTD-REG(#IDX-REG)
*
* ACCUMULATE BY STATUS
  DECIDE ON FIRST VALUE OF PAGAMENTO-V.SIT-PAGAMENTO
    VALUE 'G'
      MOVE 1 TO #IDX-STS
    VALUE 'P'
      MOVE 2 TO #IDX-STS
    VALUE 'C'
      MOVE 3 TO #IDX-STS
    VALUE 'D'
      MOVE 4 TO #IDX-STS
    VALUE 'E'
      MOVE 5 TO #IDX-STS
    NONE
      MOVE 1 TO #IDX-STS
  END-DECIDE
  ADD PAGAMENTO-V.VLR-BRUTO TO #TOT-STS-BRUTO(#IDX-STS)
  ADD 1 TO #QTD-STS(#IDX-STS)
*
* ACCUMULATE GRAND TOTALS
  ADD #VLR-ARR TO #TOT-GERAL-BRUTO
  ADD PAGAMENTO-V.VLR-DESCONTO-TOTAL TO #TOT-GERAL-DESC
  ADD PAGAMENTO-V.VLR-LIQUIDO  TO #TOT-GERAL-LIQ
  ADD 1 TO #QTD-GERAL
*
END-READ
*
* NO ACTIVITY IN PERIOD - RC=4 IN SIFAPJ02
IF #QTD-GERAL = 0
  WRITE 'NO PAYMENTS IN PERIOD' #COMPETENCIA
  TERMINATE 4
END-IF
*
* PRINT REPORT
PERFORM IMPRIME-CABECALHO
*
WRITE (1) 'SUMMARY BY REGION'
WRITE (1) '=========================================='
FOR #I = 1 TO 5
  WRITE (1) #NOME-REG(#I) '  QTY:' #QTD-REG(#I)
        '  GROSS:' #TOT-REG-BRUTO(#I)
        '  DEDUCT:' #TOT-REG-DESC(#I)
        '  NET:' #TOT-REG-LIQ(#I)
* ARCHIVAL COPY CMWKF01 - TICKET 7120/2014
  RESET #LINHA-REL
  COMPRESS 'REG' #NOME-REG(#I) #QTD-REG(#I)
      #TOT-REG-BRUTO(#I) #TOT-REG-DESC(#I)
      #TOT-REG-LIQ(#I) INTO #LINHA-REL
  WRITE WORK FILE 1 #LINHA-REL
END-FOR
*
WRITE (1) ' '
WRITE (1) 'SUMMARY BY STATUS'
WRITE (1) '=========================================='
FOR #I = 1 TO 5
  WRITE (1) #NOME-STS(#I) '  QTY:' #QTD-STS(#I)
        '  GROSS:' #TOT-STS-BRUTO(#I)
  RESET #LINHA-REL
  COMPRESS 'STS' #NOME-STS(#I) #QTD-STS(#I)
      #TOT-STS-BRUTO(#I) INTO #LINHA-REL
  WRITE WORK FILE 1 #LINHA-REL
END-FOR
*
WRITE (1) ' '
WRITE (1) '=========================================='
WRITE (1) 'GRAND TOTAL  QTY:' #QTD-GERAL
      '  GROSS:' #TOT-GERAL-BRUTO
      '  DEDUCT:' #TOT-GERAL-DESC
      '  NET:' #TOT-GERAL-LIQ
WRITE (1) '=========================================='
*
RESET #LINHA-REL
COMPRESS 'TOT' #COMPETENCIA #QTD-GERAL #TOT-GERAL-BRUTO
    #TOT-GERAL-DESC #TOT-GERAL-LIQ INTO #LINHA-REL
WRITE WORK FILE 1 #LINHA-REL
CLOSE WORK FILE 1
*
WRITE 'BATCHREL COMPLETED - RECORDS:' #QTD-GERAL
TERMINATE 0
*
* --------------------------------------------------------
* NATURAL ERROR HANDLING - TICKET 4182/2004
* --------------------------------------------------------
ON ERROR
  WRITE 'NATURAL ERROR NO.:' *ERROR-NR
  WRITE 'LINE.............:' *ERROR-LINE
  WRITE 'PROGRAM..........:' *PROGRAM
  WRITE 'PERIOD...........:' #COMPETENCIA
  BACKOUT TRANSACTION
  CLOSE WORK FILE 1
  TERMINATE 12
END-ERROR
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE IMPRIME-CABECALHO
  ADD 1 TO #PAG
  WRITE (1) '/' /* FORM FEED */
  WRITE (1) 'SIFAP - MONTHLY CONSOLIDATED REPORT'
        52X 'PAGE:' #PAG
  WRITE (1) 'PERIOD:' #COMPETENCIA
        52X 'DATE:' #DT-HOJE
  WRITE (1) 60('-')
  MOVE 5 TO #LINHA
END-SUBROUTINE
*
END
