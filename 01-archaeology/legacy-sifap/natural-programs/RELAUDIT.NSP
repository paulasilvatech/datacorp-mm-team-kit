* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* PROGRAM: RELAUDIT
* SYSTEM:  SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:  ROBERTO MENDES JUNIOR
* DATE:    20/08/2002
* CHANGED: 12/12/2006 - ROBERTO MENDES - ADD FILTERS
* CHANGED: 30/04/2011 - ANDERSON LIMA  - ADJUST FORMAT
* CHANGED: 15/09/2014 - FERNANDA COSTA - CLEAN UP REPORT
* CHANGED: 18/06/2017 - PATRICIA GOMES - LOGICAL PRINTER 1
* CHANGED: 30/05/2018 - PATRICIA GOMES - ALIGN VIEW WITH DDM
* PURPOSE: SYSTEM AUDIT TRAIL REPORT
*          EVENT LIST WITH PERIOD/ACTION FILTERS
*          PRINTER/SCREEN OUTPUT - FILE 170
* EXECUTION: ON DEMAND - NOT SCHEDULED IN SIFAPJ02.
*            FOR OUTPUT=I THE JOB MUST ALLOCATE DD CMPRT01
*            USING THE SAME STANDARD AS SIFAPJ02 (LRECL=133).
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
LOCAL USING LDASIFAP
LOCAL
  1 AUDITORIA-V VIEW OF AUDITORIA
    2 NUM-AUDITORIA      (N15)
    2 DT-EVENTO          (N8)
    2 HR-EVENTO          (N6)
    2 USR-EVENTO         (A8)
    2 COD-ACAO           (A2)
    2 TIPO-ENTIDADE      (A4)
    2 ID-ENTIDADE        (A15)
    2 VLR-ANTERIOR       (A60)
    2 VLR-NOVO           (A60)
    2 DES-ACAO           (A80)
*
  1 #DT-INI              (N8)
  1 #DT-FIM              (N8)
  1 #ACAO-FILTRO         (A2)
  1 #USUARIO-FILTRO      (A8)
  1 #TABELA-FILTRO       (A4)
  1 #DT-HOJE             (N8)
  1 #TIPO-SAIDA          (A1)   /* T=SCREEN I=PRINTER */
*
* COUNTERS
  1 #QTD-TOTAL           (N8)
  1 #QTD-EXIBIDOS        (N8)
  1 #QTD-FILTRADOS       (N8)
  1 #QTD-DIA             (N8)
*
* COUNTERS BY ACTION
  1 #QTD-INCLUSAO        (N8)
  1 #QTD-ALTERACAO       (N8)
  1 #QTD-CONSULTA        (N8)
  1 #QTD-CONCILIACAO     (N8)
  1 #QTD-DIVERGENCIA     (N8)
  1 #QTD-OUTROS          (N8)
*
  1 #PAG                 (N4)
  1 #LINHA               (N2)
  1 #MAX-LINHAS          (N2)
  1 #I                   (N2)
  1 #ACAO-DESC           (A20)
  1 #HR-FORMAT           (A8)
  1 #HR-STR              (A6)
*
* PRINT SEPARATOR LINES
  1 #SEP-100             (A100)
  1 #SEP-120             (A120)
END-DEFINE
*
* LOGICAL PRINTER 1 - USED ONLY WHEN OUTPUT = I
DEFINE PRINTER (1) OUTPUT 'CMPRT01'
FORMAT (1) PS=66 LS=132
*
MOVE *DATN TO #DT-HOJE
MOVE 66 TO #MAX-LINHAS
MOVE 0 TO #PAG
MOVE 99 TO #LINHA
MOVE 0 TO #QTD-TOTAL
MOVE 0 TO #QTD-EXIBIDOS
MOVE 0 TO #QTD-FILTRADOS
MOVE 0 TO #QTD-DIA
MOVE 0 TO #QTD-INCLUSAO
MOVE 0 TO #QTD-ALTERACAO
MOVE 0 TO #QTD-CONSULTA
MOVE 0 TO #QTD-CONCILIACAO
MOVE 0 TO #QTD-DIVERGENCIA
MOVE 0 TO #QTD-OUTROS
*
MOVE ALL '-' TO #SEP-100
MOVE ALL '-' TO #SEP-120
*
INPUT 'SIFAP - AUDIT REPORT' /
      '============================' /
      'START DATE.......:' #DT-INI /
      'END DATE.........:' #DT-FIM /
      'ACTION (BLANK=ALL):' #ACAO-FILTRO /
      'USER (BLANK=ALL)..:' #USUARIO-FILTRO /
      'TABLE (BLANK=ALL).:' #TABELA-FILTRO /
      'OUTPUT (T=SCREEN I=PRINT):' #TIPO-SAIDA
*
IF #TIPO-SAIDA = ' '
  MOVE 'T' TO #TIPO-SAIDA
END-IF
*
IF #DT-INI = 0
  MOVE 19970101 TO #DT-INI
END-IF
IF #DT-FIM = 0
  MOVE #DT-HOJE TO #DT-FIM
END-IF
*
* PROCESSING
READ AUDITORIA-V BY DT-EVENTO STARTING FROM #DT-INI
     THRU #DT-FIM
*
  AT START OF DATA
    RESET #QTD-TOTAL #QTD-EXIBIDOS #QTD-FILTRADOS #QTD-DIA
  END-START
*
  IF AUDITORIA-V.DT-EVENTO < #DT-INI
    ESCAPE TOP
  END-IF
  IF AUDITORIA-V.DT-EVENTO > #DT-FIM
    ESCAPE BOTTOM
  END-IF
*
  ADD 1 TO #QTD-TOTAL
*
* ============================================
* ACTION FILTER - DELETIONS ARE NOT DISPLAYED
* ============================================
  IF AUDITORIA-V.COD-ACAO = 'EX'
    ADD 1 TO #QTD-FILTRADOS
    ESCAPE TOP
  END-IF
*
* ACTION FILTER (IF PROVIDED)
  IF #ACAO-FILTRO NE ' '
    IF AUDITORIA-V.COD-ACAO NE #ACAO-FILTRO
      ADD 1 TO #QTD-FILTRADOS
      ESCAPE TOP
    END-IF
  END-IF
*
* USER FILTER (IF PROVIDED)
  IF #USUARIO-FILTRO NE ' '
    IF AUDITORIA-V.USR-EVENTO NE #USUARIO-FILTRO
      ADD 1 TO #QTD-FILTRADOS
      ESCAPE TOP
    END-IF
  END-IF
*
* TABLE FILTER (IF PROVIDED)
  IF #TABELA-FILTRO NE ' '
    IF AUDITORIA-V.TIPO-ENTIDADE NE #TABELA-FILTRO
      ADD 1 TO #QTD-FILTRADOS
      ESCAPE TOP
    END-IF
  END-IF
*
  ADD 1 TO #QTD-EXIBIDOS
  ADD 1 TO #QTD-DIA
*
* COUNTERS BY ACTION TYPE
  DECIDE ON FIRST VALUE OF AUDITORIA-V.COD-ACAO
    VALUE 'IN'
      ADD 1 TO #QTD-INCLUSAO
      MOVE 'INSERTION' TO #ACAO-DESC
    VALUE 'AL'
      ADD 1 TO #QTD-ALTERACAO
      MOVE 'CHANGE' TO #ACAO-DESC
    VALUE 'CO'
      ADD 1 TO #QTD-CONCILIACAO
      MOVE 'RECONCILIATION' TO #ACAO-DESC
    VALUE 'CN'
      ADD 1 TO #QTD-CONSULTA
      MOVE 'QUERY' TO #ACAO-DESC
    VALUE 'DV'
      ADD 1 TO #QTD-DIVERGENCIA
      MOVE 'DISCREPANCY' TO #ACAO-DESC
    NONE
      ADD 1 TO #QTD-OUTROS
      MOVE 'OTHER' TO #ACAO-DESC
  END-DECIDE
*
* FORMAT TIME
  MOVE EDITED AUDITORIA-V.HR-EVENTO (EM=999999) TO #HR-STR
  COMPRESS SUBSTR(#HR-STR,1,2) ':' SUBSTR(#HR-STR,3,2) ':'
           SUBSTR(#HR-STR,5,2) INTO #HR-FORMAT LEAVING NO SPACE
*
* PAGINATION
  IF #LINHA >= (#MAX-LINHAS - 5)
    PERFORM IMPRIME-CAB-AUDIT
  END-IF
*
* PRINT DETAIL
  IF #TIPO-SAIDA = 'T'
    WRITE AUDITORIA-V.DT-EVENTO ' '
          #HR-FORMAT ' '
          AUDITORIA-V.USR-EVENTO ' '
          #ACAO-DESC ' '
          AUDITORIA-V.TIPO-ENTIDADE ' '
          AUDITORIA-V.ID-ENTIDADE
  ELSE
    WRITE (1) AUDITORIA-V.DT-EVENTO ' '
          #HR-FORMAT ' '
          AUDITORIA-V.USR-EVENTO ' '
          #ACAO-DESC ' '
          AUDITORIA-V.TIPO-ENTIDADE ' '
          AUDITORIA-V.ID-ENTIDADE ' '
          AUDITORIA-V.DES-ACAO
  END-IF
  ADD 1 TO #LINHA
*
* CONTROL BREAK BY DAY - TICKET 7734/2017
* SUBTOTAL ONLY ON PRINTER TO AVOID CHANGING THE SCREEN
  AT BREAK OF AUDITORIA-V.DT-EVENTO
    IF #TIPO-SAIDA NE 'T'
      WRITE (1) '   DAY SUBTOTAL' OLD(AUDITORIA-V.DT-EVENTO)
                ':' #QTD-DIA 'EVENTS'
      ADD 1 TO #LINHA
    END-IF
    MOVE 0 TO #QTD-DIA
  END-BREAK
*
* PRINTER GRAND TOTAL
  AT END OF DATA
    IF #TIPO-SAIDA NE 'T'
      WRITE (1) #SEP-120
      WRITE (1) 'TOTAL EVENTS DISPLAYED:' #QTD-EXIBIDOS
    END-IF
  END-ENDDATA
*
END-READ
*
* SUMMARY
WRITE ' ' /
      '====================================' /
      'AUDIT SUMMARY' /
      '====================================' /
      'TOTAL RECORDS......:' #QTD-TOTAL /
      'DISPLAYED..........:' #QTD-EXIBIDOS /
      'FILTERED...........:' #QTD-FILTRADOS /
      ' ' /
      'BY ACTION TYPE:' /
      '  INSERTIONS.......:' #QTD-INCLUSAO /
      '  CHANGES..........:' #QTD-ALTERACAO /
      '  QUERIES..........:' #QTD-CONSULTA /
      '  RECONCILIATIONS..:' #QTD-CONCILIACAO /
      '  DISCREPANCIES....:' #QTD-DIVERGENCIA /
      '  OTHER............:' #QTD-OUTROS /
      '===================================='
*
* ============================================
* EVENT DISTRIBUTION BY DAY (HISTOGRAM)
* PRINTER ONLY - TICKET 7734/2017
* ============================================
IF #TIPO-SAIDA NE 'T'
  WRITE (1) ' '
  WRITE (1) 'EVENT DISTRIBUTION BY DAY'
  WRITE (1) #SEP-100
  HISTOGRAM AUDITORIA-V FOR DT-EVENTO
            STARTING FROM #DT-INI THRU #DT-FIM
    WRITE (1) 'DATE:' AUDITORIA-V.DT-EVENTO
              '  OCCURRENCES:' *NUMBER
  END-HISTOGRAM
  WRITE (1) #SEP-100
END-IF
*
* ============================================
* NATURAL ERROR HANDLING - TICKET 5512/2005
* ============================================
ON ERROR
  WRITE 'NATURAL ERROR:' *ERROR-NR
        'LINE:' *ERROR-LINE
        'PGM:' *PROGRAM
  TERMINATE 12
END-ERROR
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE IMPRIME-CAB-AUDIT
  ADD 1 TO #PAG
  IF #TIPO-SAIDA = 'T'
    WRITE '/'
    WRITE 'SIFAP - AUDIT TRAIL'
          40X 'PAGE:' #PAG
    WRITE 'PERIOD:' #DT-INI 'TO' #DT-FIM
          40X 'DATE:' #DT-HOJE
    WRITE #SEP-100
    WRITE 'DATE       TIME     USER     ACTION'
          20X 'TABLE          KEY'
    WRITE #SEP-100
  ELSE
    NEWPAGE (1)
    WRITE (1) NOTITLE 'SIFAP - AUDIT TRAIL'
          40X 'PAGE:' #PAG
    WRITE (1) 'PERIOD:' #DT-INI 'TO' #DT-FIM
          40X 'DATE:' #DT-HOJE
    WRITE (1) #SEP-120
    WRITE (1) 'DATE       TIME     USER     ACTION'
          20X 'TABLE          KEY                 DESCRIPTION'
    WRITE (1) #SEP-120
  END-IF
  MOVE 7 TO #LINHA
END-SUBROUTINE
*
END
