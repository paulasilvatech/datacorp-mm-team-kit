* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* SUBPROGRAM: VALBENEF
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   MARCIA HELENA OLIVEIRA
* DATE:     08/01/1998
* CHANGED:  17/05/2005 - MARCIA HELENA - ADJUST CPF VALIDATION
* CHANGED:  30/11/2010 - JOSE FERREIRA - ADD NAME VALIDATION
* CHANGED:  18/08/2011 - ROBERTO MENDES - CONVERT TO SUBPROGRAM
* PURPOSE:  VALIDATE BENEFICIARY REGISTRATION DATA
*           ROUTINE CALLED BEFORE WRITING - FILE 150
*           TICKET 6621/2011 - UNTIL 2011, INPUT VARIABLES
*           WERE NEVER POPULATED. IT NOW RECEIVES
*           EVERYTHING BY PARAMETER - SEE CALLNAT IN CADBENEF.
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
PARAMETER
  1 #CPF-STR             (A11)        /* IN
  1 #NOME                (A60)        /* IN
  1 #DT-NASC             (N8)         /* IN
  1 #SEXO                (A1)         /* IN
  1 #UF                  (A2)         /* IN
  1 #CEP                 (N8)         /* IN
  1 #STATUS              (A1)         /* IN
  1 #RESULTADO           (A1)         /* OUT V=VALID I=INVALID
  1 #QTD-ERROS           (N2)         /* OUT
  1 #MSG-ERRO            (A60/1:10)   /* OUT
LOCAL USING LDASIFAP
LOCAL
* VIEW DECLARED SINCE 1998 AND NEVER READ - TICKET 4471/2003
  1 BENEFICIARIO-V VIEW OF BENEFICIARIO
    2 NUM-CPF            (A11)
    2 NOME-COMPLETO      (A60)
    2 DT-NASCIMENTO      (N8)
    2 SEXO               (A1)
    2 GRP-ENDERECO
      3 UF               (A2)
      3 CEP              (N8)
    2 SIT-BENEFICIARIO   (A1)
*
  1 #CPF                 (N11)
  1 #UF-OK               (L)
  1 #CPF-VALIDO          (L)
  1 #DT-VALIDA           (L)
  1 #NOME-VALIDO         (L)
*
* CPF VALIDATION VARIABLES
  1 #DIG                 (N1/1:11)
  1 #SOMA                (N5)
  1 #RESTO               (N3)
  1 #DV1                 (N1)
  1 #DV2                 (N1)
  1 #PESO                (N2)
  1 #I                   (N2)
  1 #TODOS-IGUAIS        (L)
*
* DATE VALIDATION VARIABLES
  1 #ANO                 (N4)
  1 #MES                 (N2)
  1 #DIA                 (N2)
  1 #DIAS-MES            (N2/1:12)
  1 #ANO-ATUAL           (N4)
*
* NAME VALIDATION VARIABLES
  1 #NOME-TEMP           (A60)
  1 #POS                 (N2)
  1 #TEM-ESPACO          (L)
  1 #CHAR                (A1)
*
* VALID UFS
  1 #UF-TAB              (A2/1:27)
END-DEFINE
*
* LOAD UF TABLE
MOVE 'AC' TO #UF-TAB(1)
MOVE 'AL' TO #UF-TAB(2)
MOVE 'AM' TO #UF-TAB(3)
MOVE 'AP' TO #UF-TAB(4)
MOVE 'BA' TO #UF-TAB(5)
MOVE 'CE' TO #UF-TAB(6)
MOVE 'DF' TO #UF-TAB(7)
MOVE 'ES' TO #UF-TAB(8)
MOVE 'GO' TO #UF-TAB(9)
MOVE 'MA' TO #UF-TAB(10)
MOVE 'MG' TO #UF-TAB(11)
MOVE 'MS' TO #UF-TAB(12)
MOVE 'MT' TO #UF-TAB(13)
MOVE 'PA' TO #UF-TAB(14)
MOVE 'PB' TO #UF-TAB(15)
MOVE 'PE' TO #UF-TAB(16)
MOVE 'PI' TO #UF-TAB(17)
MOVE 'PR' TO #UF-TAB(18)
MOVE 'RJ' TO #UF-TAB(19)
MOVE 'RN' TO #UF-TAB(20)
MOVE 'RO' TO #UF-TAB(21)
MOVE 'RR' TO #UF-TAB(22)
MOVE 'RS' TO #UF-TAB(23)
MOVE 'SC' TO #UF-TAB(24)
MOVE 'SE' TO #UF-TAB(25)
MOVE 'SP' TO #UF-TAB(26)
MOVE 'TO' TO #UF-TAB(27)
*
* LOAD DAYS PER MONTH
MOVE 31 TO #DIAS-MES(1)
MOVE 29 TO #DIAS-MES(2)   /* ASSUMES LEAP YEAR */
MOVE 31 TO #DIAS-MES(3)
MOVE 30 TO #DIAS-MES(4)
MOVE 31 TO #DIAS-MES(5)
MOVE 30 TO #DIAS-MES(6)
MOVE 31 TO #DIAS-MES(7)
MOVE 31 TO #DIAS-MES(8)
MOVE 30 TO #DIAS-MES(9)
MOVE 31 TO #DIAS-MES(10)
MOVE 30 TO #DIAS-MES(11)
MOVE 31 TO #DIAS-MES(12)
*
MOVE 0 TO #QTD-ERROS
MOVE 'V' TO #RESULTADO
COMPUTE #ANO-ATUAL = *DATN / 10000
*
* CPF ARRIVES THROUGH THE INTERFACE AS A11 - TICKET 6621/2011
MOVE #CPF-STR TO #CPF
*
* ============================================
* CPF VALIDATION - MODULUS 11
* ============================================
PERFORM VALIDA-CPF-COMPLETO
IF NOT #CPF-VALIDO
  ADD 1 TO #QTD-ERROS
  MOVE 'INVALID CPF - CHECK DIGIT' TO #MSG-ERRO(#QTD-ERROS)
  MOVE 'I' TO #RESULTADO
END-IF
*
* ============================================
* BIRTH DATE VALIDATION
* ============================================
PERFORM VALIDA-DATA
IF NOT #DT-VALIDA
  ADD 1 TO #QTD-ERROS
  MOVE 'INVALID BIRTH DATE' TO #MSG-ERRO(#QTD-ERROS)
  MOVE 'I' TO #RESULTADO
END-IF
*
* ============================================
* NAME VALIDATION
* ============================================
PERFORM VALIDA-NOME
IF NOT #NOME-VALIDO
  ADD 1 TO #QTD-ERROS
  MOVE 'INVALID NAME - FIRST AND LAST NAME REQUIRED' TO #MSG-ERRO(#QTD-ERROS)
  MOVE 'I' TO #RESULTADO
END-IF
*
* ============================================
* UF VALIDATION
* ============================================
IF #UF NE ' '
  MOVE FALSE TO #UF-OK
  FOR #I = 1 TO 27
    IF #UF = #UF-TAB(#I)
      MOVE TRUE TO #UF-OK
      ESCAPE BOTTOM
    END-IF
  END-FOR
  IF NOT #UF-OK
    ADD 1 TO #QTD-ERROS
    MOVE 'INVALID UF' TO #MSG-ERRO(#QTD-ERROS)
    MOVE 'I' TO #RESULTADO
  END-IF
END-IF
*
* ============================================
* STATUS VALIDATION
* ============================================
IF #STATUS NE 'A' AND #STATUS NE 'S' AND #STATUS NE 'C'
    AND #STATUS NE 'I' AND #STATUS NE 'D'
  ADD 1 TO #QTD-ERROS
  MOVE 'INVALID STATUS' TO #MSG-ERRO(#QTD-ERROS)
  MOVE 'I' TO #RESULTADO
END-IF
*
* RESULT RETURNED THROUGH THE INTERFACE - TICKET 6621/2011
* WRITE REMOVED: VALIDATOR CALLED BY BATCH DOES NOT WRITE
* TO SCREEN. SEE #RESULTADO / #QTD-ERROS / #MSG-ERRO.
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
ON ERROR
  ADD 1 TO #QTD-ERROS
  COMPRESS 'NATURAL ERROR' *ERROR-NR
           'LINE' *ERROR-LINE
           'PGM' *PROGRAM INTO #MSG-ERRO(#QTD-ERROS)
  MOVE 'I' TO #RESULTADO
  ESCAPE ROUTINE
END-ERROR
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE VALIDA-CPF-COMPLETO
  MOVE TRUE TO #CPF-VALIDO
  MOVE #CPF TO #CPF-STR
*
* EXTRACT DIGITS
  FOR #I = 1 TO 11
    MOVE SUBSTR(#CPF-STR,#I,1) TO #DIG(#I)
  END-FOR
*
* CPF WITH ALL DIGITS EQUAL
  MOVE TRUE TO #TODOS-IGUAIS
  FOR #I = 2 TO 11
    IF #DIG(#I) NE #DIG(1)
      MOVE FALSE TO #TODOS-IGUAIS
      ESCAPE BOTTOM
    END-IF
  END-FOR
  IF #TODOS-IGUAIS
* EXCEPTION: CPFS STARTING WITH 000 ARE VALID (GOVERNMENT TEST)
    IF #DIG(1) = 0 AND #DIG(2) = 0 AND #DIG(3) = 0
      MOVE TRUE TO #CPF-VALIDO
      ESCAPE ROUTINE
    END-IF
    MOVE FALSE TO #CPF-VALIDO
    ESCAPE ROUTINE
  END-IF
*
* FIRST CHECK DIGIT
  MOVE 0 TO #SOMA
  MOVE 10 TO #PESO
  FOR #I = 1 TO 9
    COMPUTE #SOMA = #SOMA + (#DIG(#I) * #PESO)
    SUBTRACT 1 FROM #PESO
  END-FOR
  COMPUTE #RESTO = #SOMA - ((#SOMA / 11) * 11)
  IF #RESTO < 2
    MOVE 0 TO #DV1
  ELSE
    COMPUTE #DV1 = 11 - #RESTO
  END-IF
  IF #DV1 NE #DIG(10)
    MOVE FALSE TO #CPF-VALIDO
    ESCAPE ROUTINE
  END-IF
*
* SECOND CHECK DIGIT
  MOVE 0 TO #SOMA
  MOVE 11 TO #PESO
  FOR #I = 1 TO 10
    COMPUTE #SOMA = #SOMA + (#DIG(#I) * #PESO)
    SUBTRACT 1 FROM #PESO
  END-FOR
  COMPUTE #RESTO = #SOMA - ((#SOMA / 11) * 11)
  IF #RESTO < 2
    MOVE 0 TO #DV2
  ELSE
    COMPUTE #DV2 = 11 - #RESTO
  END-IF
  IF #DV2 NE #DIG(11)
    MOVE FALSE TO #CPF-VALIDO
  END-IF
END-SUBROUTINE
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE VALIDA-DATA
  MOVE TRUE TO #DT-VALIDA
  COMPUTE #ANO = #DT-NASC / 10000
  COMPUTE #MES = (#DT-NASC - (#ANO * 10000)) / 100
  COMPUTE #DIA = #DT-NASC - (#ANO * 10000) - (#MES * 100)
*
* Y2K - REMEDIATION 08/1998 - BUG2000 PROJECT - R.SOUZA TEAM
* UNTIL 07/1998, BIRTH DATE ARRIVED AS YYMMDD (N6), AND THE
* CENTURY WAS RESOLVED BY THE LDA #L-SEC-JANELA WINDOW.
* BLOCK RETAINED AS COMMENTS FOR HISTORICAL FILES - TICKET 2118
*    COMPUTE #L-AA-CURTO = #DT-NASC / 10000
*    IF #L-AA-CURTO < #L-SEC-JANELA
*      COMPUTE #L-ANO-EXPANDIDO = 2000 + #L-AA-CURTO
*    ELSE
*      COMPUTE #L-ANO-EXPANDIDO = 1900 + #L-AA-CURTO
*    END-IF
*    MOVE #L-ANO-EXPANDIDO TO #ANO
*
  IF #ANO < 1900 OR #ANO > #ANO-ATUAL
    MOVE FALSE TO #DT-VALIDA
    ESCAPE ROUTINE
  END-IF
  IF #MES < 1 OR #MES > 12
    MOVE FALSE TO #DT-VALIDA
    ESCAPE ROUTINE
  END-IF
  IF #DIA < 1 OR #DIA > #DIAS-MES(#MES)
    MOVE FALSE TO #DT-VALIDA
  END-IF
END-SUBROUTINE
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE VALIDA-NOME
  MOVE TRUE TO #NOME-VALIDO
  IF #NOME = ' '
    MOVE FALSE TO #NOME-VALIDO
    ESCAPE ROUTINE
  END-IF
* CHECK FOR AT LEAST ONE SPACE (FIRST NAME + LAST NAME)
  MOVE FALSE TO #TEM-ESPACO
  EXAMINE #NOME FOR ' ' GIVING POSITION #POS
  IF #POS > 1
    MOVE TRUE TO #TEM-ESPACO
  END-IF
  IF NOT #TEM-ESPACO
    MOVE FALSE TO #NOME-VALIDO
  END-IF
END-SUBROUTINE
*
END
