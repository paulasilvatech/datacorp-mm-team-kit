* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* PROGRAM:  CADBENEF
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   CARLOS ROBERTO DA SILVA
* DATE:     15/03/1997
* CHANGED:  22/08/2005 - MARCIA HELENA - ADDED CPF VALIDATION
* CHANGED:  10/01/2011 - JOSE FERREIRA - ADJUSTED ELDERLY STATUS
* CHANGED:  07/06/2011 - ROBERTO MENDES - ADDED VALIDATION CALLNAT
* CHANGED:  12/09/2012 - ANDERSON LIMA  - ADDED AUDIT TRAIL
* PURPOSE:  BENEFICIARY REGISTRATION - ADD/UPDATE
*           MAINTAIN REGISTRATION DATA IN FILE 150
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
LOCAL USING PDAVALID
LOCAL
  1 BENEFICIARIO-V VIEW OF BENEFICIARIO
    2 NUM-CPF            (A11)
    2 NOME-COMPLETO      (A60)
    2 DT-NASCIMENTO      (N8)
    2 SEXO               (A1)
    2 GRP-ENDERECO
      3 LOGRADOURO       (A60)
      3 BAIRRO           (A40)
      3 MUNICIPIO        (A40)
      3 UF               (A2)
      3 CEP              (N8)
    2 TEL-CELULAR        (A15)
    2 RG-NUMERO          (A15)
    2 SIT-BENEFICIARIO   (A1)
    2 COD-PROGRAMA       (A4)
    2 VLR-RENDA-FAMILIAR (P9,2)
    2 QTD-DEPENDENTES    (N2)
    2 DT-CADASTRO        (N8)
    2 DT-ULT-ALTERACAO   (N8)
    2 COD-REGIAO         (A2)
    2 NUM-NIS            (N11)
*
* AUDIT TRAIL - FILE 153 - IN-TCU 63/2010
  1 AUDITORIA-V VIEW OF AUDITORIA
    2 NUM-AUDITORIA      (N15)
    2 DT-EVENTO          (N8)
    2 HR-EVENTO          (N6)
    2 TS-EVENTO          (N14)
    2 COD-ACAO           (A2)
    2 COD-MODULO         (A8)
    2 DES-ACAO           (A80)
    2 TIPO-ENTIDADE      (A4)
    2 ID-ENTIDADE        (A15)
    2 NUM-CPF-AFETADO    (A11)
    2 USR-EVENTO         (A8)
    2 NOM-JOB-BATCH      (A16)
    2 SIT-BATCH          (A1)
*
  1 #CPF                 (N11)
  1 #NOME                (A60)
  1 #DT-NASC             (N8)
  1 #SEXO                (A1)
  1 #ENDERECO            (A80)
  1 #MUNICIPIO           (A40)
  1 #UF                  (A2)
  1 #CEP                 (N8)
  1 #TELEFONE            (A15)
  1 #RG                  (A15)
  1 #STATUS              (A1)
  1 #COD-PROG            (N4)
  1 #RENDA-FAM           (P9,2)
  1 #NUM-DEP             (N2)
  1 #COD-REG             (N2)
  1 #NIS                 (N11)
*
  1 #OPER                (A1)    /* I=ADD A=UPDATE */
  1 #DT-HOJE             (N8)
  1 #ANO-ATUAL           (N4)
  1 #ANO-NASC            (N4)
  1 #IDADE               (N3)
  1 #MSG                 (A60)
  1 #ERRO                (L)
  1 #CPF-VALIDO          (L)
  1 #FOUND               (L)
*
* CORPORATE VALIDATION RESULT - CALLNAT VALBENEF
  1 #RESULTADO           (A1)
  1 #QTD-ERROS           (N2)
  1 #MSG-ERRO            (A60/1:10)
*
* AUDIT TRAIL FIELDS - CCAUDIT
  1 #AUD-ACAO            (A2)
  1 #AUD-ENTIDADE        (A4)
  1 #AUD-ID              (A15)
  1 #AUD-CPF             (A11)
  1 #AUD-DESCRICAO       (A80)
  1 #AUD-SEQ             (N15)
  1 #AUD-TIMN            (N7)
*
* VARIABLES FOR CPF VALIDATION
  1 #CPF-STR             (A11)
  1 #DIG                 (N1/1:11)
  1 #SOMA                (N5)
  1 #RESTO               (N3)
  1 #DV1                 (N1)
  1 #DV2                 (N1)
  1 #PESO                (N2)
  1 #I                   (N2)
END-DEFINE
*
* GET CURRENT DATE
MOVE *DATN TO #DT-HOJE
* TICKET 6622/2011 - YEAR EXTRACTION CORRECTED
* (USED DIVIDE WITH REMAINDER IN THE SAME VARIABLE)
COMPUTE #ANO-ATUAL = #DT-HOJE / 10000
*
* FLOW CONTROL - TICKET 6622/2011
* OUTER REPEAT ENABLES EARLY EXIT FROM VALIDATIONS
* (ESCAPE BOTTOM) WITHOUT REWRITING THE RULES
REPEAT
*
INPUT 'SIFAP - BENEFICIARY REGISTRATION' /
      '=================================' /
      'OPERATION (I/A):' #OPER /
      'CPF...........:' #CPF /
      'NAME..........:' #NOME /
      'BIRTH DATE....:' #DT-NASC '(YYYYMMDD)' /
      'SEX...........:' #SEXO '(M/F)' /
      'ADDRESS.......:' #ENDERECO /
      'CITY..........:' #MUNICIPIO /
      'STATE.........:' #UF /
      'ZIP CODE......:' #CEP /
      'PHONE.........:' #TELEFONE /
      'RG............:' #RG /
      'PROGRAM CODE..:' #COD-PROG /
      'FAMILY INCOME.:' #RENDA-FAM /
      'DEPENDENT COUNT:' #NUM-DEP /
      'REGION CODE...:' #COD-REG /
      'NIS...........:' #NIS
*
* BASIC VALIDATION
MOVE FALSE TO #ERRO
*
IF #OPER NE 'I' AND #OPER NE 'A'
  MOVE 'INVALID OPERATION - ENTER I OR A' TO #MSG
  MOVE TRUE TO #ERRO
  ESCAPE BOTTOM
END-IF
*
IF #CPF = 0
  MOVE 'CPF IS REQUIRED' TO #MSG
  MOVE TRUE TO #ERRO
  ESCAPE BOTTOM
END-IF
*
* CPF VALIDATION - MOD 11 ALGORITHM
PERFORM VALIDA-CPF
* ============================================
* CPF VALIDATION BY CORPORATE ROUTINE
* TICKET 6620/2011 - INTERNAL ROUTINE ABOVE
* RETAINED PENDING BENEFITS DEPARTMENT REVIEW
* ============================================
MOVE 'C' TO #PV-TIPO-DOC
MOVE EDITED #CPF (EM=99999999999) TO #PV-CPF
RESET #PV-NIS
CALLNAT 'SUBVALCP' #PV-TIPO-DOC #PV-CPF #PV-NIS
                   #PV-COD-RETORNO #PV-MSG
                   #PV-IND-ESPECIAL
IF NOT #CPF-VALIDO
  MOVE 'INVALID CPF - INCORRECT CHECK DIGIT' TO #MSG
  MOVE TRUE TO #ERRO
  ESCAPE BOTTOM
END-IF
*
IF #NOME = ' '
  MOVE 'NAME IS REQUIRED' TO #MSG
  MOVE TRUE TO #ERRO
  ESCAPE BOTTOM
END-IF
*
IF #DT-NASC = 0
  MOVE 'BIRTH DATE IS REQUIRED' TO #MSG
  MOVE TRUE TO #ERRO
  ESCAPE BOTTOM
END-IF
*
IF #SEXO NE 'M' AND #SEXO NE 'F'
  MOVE 'INVALID SEX' TO #MSG
  MOVE TRUE TO #ERRO
  ESCAPE BOTTOM
END-IF
*
* ============================================
* NIS/PIS VALIDATION - TICKET 6621/2011
* WARNING MODE - DOES NOT BLOCK SAVING PENDING
* BENEFITS DEPARTMENT REVIEW
* ============================================
MOVE 'N' TO #PV-TIPO-DOC
RESET #PV-CPF
MOVE EDITED #NIS (EM=99999999999) TO #PV-NIS
CALLNAT 'SUBVALNI' #PV-TIPO-DOC #PV-CPF #PV-NIS
                   #PV-COD-RETORNO #PV-MSG
                   #PV-IND-ESPECIAL
IF #PV-COD-RETORNO NE 0
  WRITE 'WARNING -' #PV-MSG
END-IF
*
* CHECK WHETHER BENEFICIARY EXISTS - READ FILE 150
* CPF IS ALPHANUMERIC IN FILE 150 (AB NUM-CPF A11)
MOVE EDITED #CPF (EM=99999999999) TO #CPF-STR
FIND BENEFICIARIO-V WITH NUM-CPF = #CPF-STR
  IF NO RECORDS FOUND
    MOVE FALSE TO #FOUND
  END-NOREC
  MOVE TRUE TO #FOUND
END-FIND
*
IF #OPER = 'I' AND #FOUND
  MOVE 'BENEFICIARY ALREADY REGISTERED' TO #MSG
  MOVE TRUE TO #ERRO
  ESCAPE BOTTOM
END-IF
*
IF #OPER = 'A' AND NOT #FOUND
  MOVE 'BENEFICIARY NOT FOUND FOR UPDATE' TO #MSG
  MOVE TRUE TO #ERRO
  ESCAPE BOTTOM
END-IF
*
* CALCULATE BENEFICIARY AGE
* ============================================
* Y2K - REMEDIATION 08/1998 - BUG2000 PROJECT
* TEAM: R.SOUZA - TICKET 1998/0442
* UNTIL 07/1998 THE DATE ARRIVED AS YYMMDD AND THE YEAR
* WAS EXPANDED USING THE CENTURY WINDOW BELOW:
*    MOVE #DT-NASC TO #AA-CURTO
*    IF #AA-CURTO < 50
*      COMPUTE #ANO-NASC = 2000 + #AA-CURTO
*    ELSE
*      COMPUTE #ANO-NASC = 1900 + #AA-CURTO
*    END-IF
* FIELD CONVERTED TO YYYYMMDD IN 08/1998
* WINDOW RETAINED IN LDASIFAP FOR HISTORICAL FILES
* ============================================
* TICKET 6622/2011 - YEAR EXTRACTION CORRECTED
COMPUTE #ANO-NASC = #DT-NASC / 10000
COMPUTE #IDADE = #ANO-ATUAL - #ANO-NASC
*
* SET INITIAL STATUS
IF #OPER = 'I'
  MOVE 'A' TO #STATUS
END-IF
*
* ADJUST FOR BENEFICIARIES OVER 75 YEARS OLD
IF #IDADE > 75
  MOVE 'S' TO #STATUS
END-IF
*
IF #ERRO
  ESCAPE BOTTOM
END-IF
*
* ============================================
* CORPORATE REGISTRATION VALIDATION - VALBENEF
* TICKET 6620/2011 - WARNING MODE PENDING BENEFITS
* DEPARTMENT REVIEW - DOES NOT BLOCK
* ============================================
CALLNAT 'VALBENEF' #CPF-STR #NOME #DT-NASC #SEXO #UF #CEP
                   #STATUS #RESULTADO #QTD-ERROS
                   #MSG-ERRO(*)
IF #RESULTADO = 'I'
  WRITE 'WARNING - REGISTRATION VALIDATION:' #QTD-ERROS 'ERROR(S)'
END-IF
*
* SAVE / UPDATE - FILE 150
DECIDE ON FIRST VALUE OF #OPER
  VALUE 'I'
    MOVE #CPF-STR    TO BENEFICIARIO-V.NUM-CPF
    MOVE #NOME       TO BENEFICIARIO-V.NOME-COMPLETO
    MOVE #DT-NASC    TO BENEFICIARIO-V.DT-NASCIMENTO
    MOVE #SEXO       TO BENEFICIARIO-V.SEXO
* TICKET 4471/2003 - A80 ADDRESS SAVED IN
* A60 STREET FIELD - LAST 20 BYTES ARE LOST
    MOVE #ENDERECO   TO BENEFICIARIO-V.LOGRADOURO
    MOVE #MUNICIPIO  TO BENEFICIARIO-V.MUNICIPIO
    MOVE #UF         TO BENEFICIARIO-V.UF
    MOVE #CEP        TO BENEFICIARIO-V.CEP
    MOVE #TELEFONE   TO BENEFICIARIO-V.TEL-CELULAR
    MOVE #RG         TO BENEFICIARIO-V.RG-NUMERO
    MOVE #STATUS     TO BENEFICIARIO-V.SIT-BENEFICIARIO
    MOVE EDITED #COD-PROG (EM=9999)
                     TO BENEFICIARIO-V.COD-PROGRAMA
    MOVE #RENDA-FAM  TO BENEFICIARIO-V.VLR-RENDA-FAMILIAR
    MOVE #NUM-DEP    TO BENEFICIARIO-V.QTD-DEPENDENTES
    MOVE #DT-HOJE    TO BENEFICIARIO-V.DT-CADASTRO
    MOVE #DT-HOJE    TO BENEFICIARIO-V.DT-ULT-ALTERACAO
    MOVE EDITED #COD-REG (EM=99)
                     TO BENEFICIARIO-V.COD-REGIAO
    MOVE #NIS        TO BENEFICIARIO-V.NUM-NIS
    STORE BENEFICIARIO-V
* AUDIT TRAIL - TICKET 5510/2012
    MOVE 'IN'                  TO #AUD-ACAO
    MOVE 'BENF'                TO #AUD-ENTIDADE
    MOVE #CPF-STR              TO #AUD-ID
    MOVE #CPF-STR              TO #AUD-CPF
    MOVE 'REGISTRATION CREATED' TO #AUD-DESCRICAO
    PERFORM GRAVA-AUDITORIA
    END TRANSACTION
    WRITE 'BENEFICIARY ADDED SUCCESSFULLY'
  VALUE 'A'
    FIND BENEFICIARIO-V WITH NUM-CPF = #CPF-STR
      MOVE #NOME       TO BENEFICIARIO-V.NOME-COMPLETO
      MOVE #ENDERECO   TO BENEFICIARIO-V.LOGRADOURO
      MOVE #MUNICIPIO  TO BENEFICIARIO-V.MUNICIPIO
      MOVE #UF         TO BENEFICIARIO-V.UF
      MOVE #CEP        TO BENEFICIARIO-V.CEP
      MOVE #TELEFONE   TO BENEFICIARIO-V.TEL-CELULAR
      MOVE #RG         TO BENEFICIARIO-V.RG-NUMERO
      MOVE #STATUS     TO BENEFICIARIO-V.SIT-BENEFICIARIO
      MOVE #RENDA-FAM  TO BENEFICIARIO-V.VLR-RENDA-FAMILIAR
      MOVE #NUM-DEP    TO BENEFICIARIO-V.QTD-DEPENDENTES
      MOVE #DT-HOJE    TO BENEFICIARIO-V.DT-ULT-ALTERACAO
      UPDATE BENEFICIARIO-V
* AUDIT TRAIL - TICKET 5510/2012
      MOVE 'AL'                   TO #AUD-ACAO
      MOVE 'BENF'                 TO #AUD-ENTIDADE
      MOVE #CPF-STR               TO #AUD-ID
      MOVE #CPF-STR               TO #AUD-CPF
      MOVE 'REGISTRATION UPDATED' TO #AUD-DESCRICAO
      PERFORM GRAVA-AUDITORIA
      END TRANSACTION
    END-FIND
    WRITE 'BENEFICIARY UPDATED SUCCESSFULLY'
  NONE
    WRITE 'INVALID OPERATION'
END-DECIDE
*
* NORMAL EXIT - TICKET 6622/2011
ESCAPE BOTTOM
END-REPEAT
*
IF #ERRO
  WRITE #MSG
END-IF
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* SUBROUTINE: CPF VALIDATION - MODULUS 11
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE VALIDA-CPF
  MOVE TRUE TO #CPF-VALIDO
  MOVE #CPF TO #CPF-STR
*
* EXTRACT DIGITS
  FOR #I = 1 TO 11
    MOVE SUBSTR(#CPF-STR,#I,1) TO #DIG(#I)
  END-FOR
*
* FIRST CHECK DIGIT
  MOVE 0 TO #SOMA
  MOVE 10 TO #PESO
  FOR #I = 1 TO 9
    COMPUTE #SOMA = #SOMA + (#DIG(#I) * #PESO)
    SUBTRACT 1 FROM #PESO
  END-FOR
  COMPUTE #RESTO = #SOMA - ((#SOMA / 11) * 11)
  IF #RESTO < 2
    MOVE 0 TO #DV1
  ELSE
    COMPUTE #DV1 = 11 - #RESTO
  END-IF
*
  IF #DV1 NE #DIG(10)
    MOVE FALSE TO #CPF-VALIDO
    ESCAPE ROUTINE
  END-IF
*
* SECOND CHECK DIGIT
  MOVE 0 TO #SOMA
  MOVE 11 TO #PESO
  FOR #I = 1 TO 10
    COMPUTE #SOMA = #SOMA + (#DIG(#I) * #PESO)
    SUBTRACT 1 FROM #PESO
  END-FOR
  COMPUTE #RESTO = #SOMA - ((#SOMA / 11) * 11)
  IF #RESTO < 2
    MOVE 0 TO #DV2
  ELSE
    COMPUTE #DV2 = 11 - #RESTO
  END-IF
*
  IF #DV2 NE #DIG(11)
    MOVE FALSE TO #CPF-VALIDO
  END-IF
END-SUBROUTINE
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* AUDIT TRAIL - IN-TCU 63/2010 - TICKET 5510
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
INCLUDE CCAUDIT
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* NATURAL ERROR HANDLING - TICKET 5511/2012
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
ON ERROR
  WRITE 'NATURAL ERROR' *ERROR-NR 'LINE' *ERROR-LINE
  WRITE 'PGM' *PROGRAM 'LIB' *LIBRARY-ID
  BACKOUT TRANSACTION
  TERMINATE 12
END-ERROR
*
END
