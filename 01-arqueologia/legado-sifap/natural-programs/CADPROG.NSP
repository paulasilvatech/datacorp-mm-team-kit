* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* PROGRAM:  CADPROG
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   MARCOS ANTONIO RIBEIRO
* DATE:     10/09/1997
* CHANGED:  05/07/2003 - MARCOS RIBEIRO - ADDED CORRECTION FACTOR
* CHANGED:  12/09/2012 - ANDERSON LIMA  - ADDED AUDIT TRAIL
* CHANGED:  18/11/2012 - FERNANDA COSTA - NEW ELIGIBILITY CODES
* PURPOSE:  SOCIAL PROGRAM REGISTRATION - ADD/QUERY
*           MAINTAIN PROGRAM TABLE IN FILE 155
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
LOCAL USING LDASIFAP
LOCAL
  1 PROGRAMA-V VIEW OF PROGRAMA-SOCIAL
    2 COD-PROGRAMA         (A4)
    2 NOME-PROGRAMA        (A60)
    2 TIPO-PROGRAMA        (A1)  /* A=ASSISTANCE P=PENSION T=WORK
    2 VLR-BASE-INDIVIDUAL  (P7,2)
    2 COD-ELEGIBILIDADE    (A5)
    2 DT-CRIACAO           (N8)
    2 DT-ENCERRAMENTO      (N8)
    2 SIT-PROGRAMA         (A1)
    2 RENDA-MAX-PERCAP     (P7,2)
    2 IDADE-MIN            (N3)
    2 IDADE-MAX            (N3)
    2 FATOR-REAJUSTE       (P3,4)
*
* AUDIT TRAIL - FILE 153 - IN-TCU 63/2010
  1 AUDITORIA-V VIEW OF AUDITORIA
    2 NUM-AUDITORIA        (N15)
    2 DT-EVENTO            (N8)
    2 HR-EVENTO            (N6)
    2 TS-EVENTO            (N14)
    2 COD-ACAO             (A2)
    2 COD-MODULO           (A8)
    2 DES-ACAO             (A80)
    2 TIPO-ENTIDADE        (A4)
    2 ID-ENTIDADE          (A15)
    2 NUM-CPF-AFETADO      (A11)
    2 USR-EVENTO           (A8)
    2 NOM-JOB-BATCH        (A16)
    2 SIT-BATCH            (A1)
*
  1 #COD-PROG            (N4)
  1 #COD-PROG-A          (A4)
  1 #NOME-PROG           (A60)
  1 #TIPO                (A1)
  1 #VLR-BASE            (P9,2)
  1 #COD-ELEG            (A5)
  1 #DT-INICIO           (N8)
  1 #DT-FIM              (N8)
  1 #STATUS              (A1)
  1 #RENDA-MAX           (P9,2)
  1 #IDADE-MIN           (N3)
  1 #IDADE-MAX           (N3)
  1 #FATOR-REAJ          (N3,4)
  1 #FATOR-K             (N5,6)
  1 #OPER                (A1)
  1 #MSG                 (A60)
  1 #FOUND               (L)
  1 #VLR-CALC            (P9,2)
*
* AUDIT TRAIL FIELDS - CCAUDIT
  1 #AUD-ACAO            (A2)
  1 #AUD-ENTIDADE        (A4)
  1 #AUD-ID              (A15)
  1 #AUD-CPF             (A11)
  1 #AUD-DESCRICAO       (A80)
  1 #AUD-SEQ             (N15)
  1 #AUD-TIMN            (N7)
END-DEFINE
*
* FLOW CONTROL - TICKET 6622/2011
* OUTER REPEAT ENABLES EARLY EXIT
* (ESCAPE BOTTOM) WITHOUT REWRITING THE RULES
REPEAT
*
INPUT 'SIFAP - SOCIAL PROGRAM REGISTRATION' /
      '====================================' /
      'OPERATION (I/C):' #OPER /
      'PROGRAM CODE..:' #COD-PROG
*
IF #OPER NE 'I' AND #OPER NE 'C'
  WRITE 'INVALID OPERATION'
  ESCAPE BOTTOM
END-IF
*
IF #OPER = 'C'
  PERFORM CONSULTA-PROG
  ESCAPE BOTTOM
END-IF
*
* ADDITION
INPUT 'PROGRAM INFORMATION' /
      '===================' /
      'NAME..........:' #NOME-PROG /
      'TYPE..........:' #TIPO '(A/P/T)' /
      'BASE AMOUNT...:' #VLR-BASE /
      'ELIGIB. CODE..:' #COD-ELEG /
      'START DATE....:' #DT-INICIO /
      'END DATE......:' #DT-FIM '(0=OPEN-ENDED)' /
      'MAX INCOME....:' #RENDA-MAX /
      'MINIMUM AGE...:' #IDADE-MIN /
      'MAXIMUM AGE...:' #IDADE-MAX /
      'ADJUST. FACTOR:' #FATOR-REAJ
*
* CHECK FOR EXISTING PROGRAM
* COD-PROGRAMA IS ALPHANUMERIC IN FILE 151 (AA A4)
MOVE EDITED #COD-PROG (EM=9999) TO #COD-PROG-A
FIND PROGRAMA-V WITH COD-PROGRAMA = #COD-PROG-A
  IF NO RECORDS FOUND
    MOVE FALSE TO #FOUND
  END-NOREC
  MOVE TRUE TO #FOUND
END-FIND
*
IF #FOUND
  WRITE 'PROGRAM ALREADY REGISTERED'
  ESCAPE BOTTOM
END-IF
*
* CALCULATE BASE AMOUNT ADJUSTED BY FACTOR K
COMPUTE #FATOR-K = 1.00 + (#FATOR-REAJ * 0.347215)
COMPUTE #VLR-CALC = #VLR-BASE * #FATOR-K
*
MOVE #COD-PROG-A   TO PROGRAMA-V.COD-PROGRAMA
MOVE #NOME-PROG   TO PROGRAMA-V.NOME-PROGRAMA
MOVE #TIPO         TO PROGRAMA-V.TIPO-PROGRAMA
MOVE #VLR-CALC     TO PROGRAMA-V.VLR-BASE-INDIVIDUAL
MOVE #COD-ELEG     TO PROGRAMA-V.COD-ELEGIBILIDADE
MOVE #DT-INICIO    TO PROGRAMA-V.DT-CRIACAO
MOVE #DT-FIM       TO PROGRAMA-V.DT-ENCERRAMENTO
MOVE 'A'           TO PROGRAMA-V.SIT-PROGRAMA
MOVE #RENDA-MAX    TO PROGRAMA-V.RENDA-MAX-PERCAP
MOVE #IDADE-MIN    TO PROGRAMA-V.IDADE-MIN
MOVE #IDADE-MAX    TO PROGRAMA-V.IDADE-MAX
MOVE #FATOR-REAJ   TO PROGRAMA-V.FATOR-REAJUSTE
STORE PROGRAMA-V
* AUDIT TRAIL - TICKET 5510/2012
MOVE 'IN'                   TO #AUD-ACAO
MOVE 'PROG'                 TO #AUD-ENTIDADE
MOVE #COD-PROG-A            TO #AUD-ID
RESET #AUD-CPF
MOVE 'SOCIAL PROGRAM ADDED'       TO #AUD-DESCRICAO
PERFORM GRAVA-AUDITORIA
END TRANSACTION
*
WRITE 'PROGRAM ADDED SUCCESSFULLY - ADJUSTED AMOUNT:' #VLR-CALC
*
* NORMAL EXIT - TICKET 6622/2011
ESCAPE BOTTOM
END-REPEAT
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE CONSULTA-PROG
  MOVE EDITED #COD-PROG (EM=9999) TO #COD-PROG-A
  FIND PROGRAMA-V WITH COD-PROGRAMA = #COD-PROG-A
    WRITE 'PROGRAM CODE.:' PROGRAMA-V.COD-PROGRAMA /
          'NAME.........:' PROGRAMA-V.NOME-PROGRAMA /
          'TYPE.........:' PROGRAMA-V.TIPO-PROGRAMA /
          'BASE AMOUNT..:' PROGRAMA-V.VLR-BASE-INDIVIDUAL /
          'ELIGIBILITY..:' PROGRAMA-V.COD-ELEGIBILIDADE /
          'STATUS.......:' PROGRAMA-V.SIT-PROGRAMA
  END-FIND
* OLD 1997 STYLE - NOT STANDARDIZED FOR NO RECORDS
* FOUND. RETAINED - TICKET 3312/2004 IS OPEN
  IF *NUMBER(PROGRAMA-V) = 0
    WRITE 'PROGRAM NOT FOUND'
  END-IF
END-SUBROUTINE
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* AUDIT TRAIL - IN-TCU 63/2010 - TICKET 5510
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
INCLUDE CCAUDIT
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* NATURAL ERROR HANDLING - TICKET 5511/2012
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
ON ERROR
  WRITE 'NATURAL ERROR' *ERROR-NR 'LINE' *ERROR-LINE
  WRITE 'PGM' *PROGRAM 'LIB' *LIBRARY-ID
  BACKOUT TRANSACTION
  TERMINATE 12
END-ERROR
*
END
