* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* SUBPROGRAM: CALCBENF
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   CARLOS ROBERTO DA SILVA
* DATE:     18/04/1997
* CHANGED:  30/11/2001 - CARLOS SILVA   - ADD 13TH SALARY
* CHANGED:  15/06/2004 - PATRICIA GOMES - ADJUST REGIONAL FACTOR
* CHANGED:  22/12/2009 - JOSE FERREIRA  - HOLIDAY BONUS
* CHANGED:  09/05/2011 - SUPDE TEAM     - TICKET 6210 CONVERT SUBP
* CHANGED:  08/03/2013 - FERNANDA COSTA - NEW INCOME BRACKETS
* CHANGED:  14/06/2016 - SUPDE TEAM     - TICKET 7210 STANDARD DDM
* PURPOSE:  CALCULATE MONTHLY BENEFIT AMOUNT
*           MAIN CALCULATION PROCESS - FILES 150/160/155
* CALLED BY: BATCHPGT VIA CALLNAT - PDACALC INTERFACE
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
PARAMETER USING PDACALC
LOCAL USING LDASIFAP
LOCAL
  1 BENEFICIARIO-V VIEW OF BENEFICIARIO
    2 NUM-CPF            (A11)
    2 NOME-COMPLETO      (A60)
    2 DT-NASCIMENTO      (N8)
    2 SIT-BENEFICIARIO   (A1)
    2 COD-PROGRAMA       (A4)
    2 VLR-RENDA-FAMILIAR (P9,2)
    2 QTD-DEPENDENTES    (N2)
    2 COD-REGIAO         (A2)
    2 UF                 (A2)
    2 NUM-NIS            (N11)
*
  1 PAGAMENTO-V VIEW OF PAGAMENTO
    2 NUM-PAGAMENTO      (N15)
    2 NUM-CPF            (A11)
    2 COD-PROGRAMA       (A4)
    2 ANO-MES-REF        (N6)     /* YYYYMM */
    2 VLR-BRUTO          (P9,2)
    2 VLR-DESCONTO-TOTAL (P7,2)
    2 VLR-LIQUIDO        (P9,2)
    2 DT-GERACAO         (N8)
    2 SIT-PAGAMENTO      (A1)
    2 TIPO-PAGAMENTO     (A1)     /* N=NORMAL D=THIRTEENTH T=THIRD */
    2 VLR-ABONO          (P9,2)
*
  1 PROGRAMA-V VIEW OF PROGRAMA-SOCIAL
    2 COD-PROGRAMA        (A4)
    2 TIPO-PROGRAMA       (A1)
    2 VLR-BASE-INDIVIDUAL (P7,2)
    2 FATOR-REAJUSTE      (P3,4)
    2 SIT-PROGRAMA        (A1)
*
* WORK VARIABLES
  1 #CPF                 (N11)
  1 #CPF-STR             (A11)
  1 #COMPETENCIA         (N6)
  1 #MES                 (N2)
  1 #ANO                 (N4)
  1 #ANO-NASC            (N4)
  1 #IDADE               (N3)
  1 #VLR-BASE            (P9,2)
  1 #VLR-BENF            (P9,2)
  1 #VLR-BRUTO           (P9,2)
  1 #VLR-DESC            (P9,2)
  1 #VLR-LIQ             (P9,2)
  1 #VLR-ABONO           (P9,2)
  1 #VLR-13              (P9,2)
  1 #VLR-TOTAL           (P9,2)
  1 #VLR-TEMP            (N11)
  1 #FATOR-REG           (N3,4)
  1 #FATOR-FAM           (N3,4)
  1 #FATOR-RND           (N3,4)
  1 #FATOR-IDADE         (N3,4)
  1 #NUM-DEP             (N2)
  1 #COD-REG             (N2)
  1 #COD-PROG            (A4)
  1 #RENDA               (P9,2)
  1 #TIPO-PROG           (A1)
  1 #FATOR-REAJ          (N3,4)
  1 #MSG                 (A78)
  1 #ERRO                (L)
  1 #DT-HOJE             (N8)
  1 #DT-NASC             (N8)
  1 #STATUS-BENEF        (A1)
  1 #TIPO-PGTO           (A1)
  1 #J                   (N2)
*
* REGIONAL FACTOR TABLE
  1 #TAB-REG             (N3,4/1:27)
*
* INCOME BRACKETS
  1 #FAIXA-RENDA         (P9,2/1:5)
  1 #FATOR-FAIXA         (N3,4/1:5)
END-DEFINE
*
MOVE *DATN TO #DT-HOJE
*
* INITIALIZE REGIONAL FACTOR TABLE
* REGIONS: 01-05=NORTH 06-10=NORTHEAST 11-15=SOUTHEAST 16-20=SOUTH 21-25=C.WEST 99=SPECIAL
MOVE 1.3500 TO #TAB-REG(1)   /* AC */
MOVE 1.3200 TO #TAB-REG(2)   /* AM */
MOVE 1.3000 TO #TAB-REG(3)   /* AP */
MOVE 1.2800 TO #TAB-REG(4)   /* PA */
MOVE 1.3100 TO #TAB-REG(5)   /* RO */
MOVE 1.4000 TO #TAB-REG(6)   /* MA */
MOVE 1.3800 TO #TAB-REG(7)   /* PI */
MOVE 1.3500 TO #TAB-REG(8)   /* CE */
MOVE 1.3200 TO #TAB-REG(9)   /* BA */
MOVE 1.3600 TO #TAB-REG(10)  /* PE */
MOVE 1.1000 TO #TAB-REG(11)  /* SP */
MOVE 1.1200 TO #TAB-REG(12)  /* RJ */
MOVE 1.0800 TO #TAB-REG(13)  /* MG */
MOVE 1.0500 TO #TAB-REG(14)  /* ES */
MOVE 1.0000 TO #TAB-REG(15)  /* REF */
MOVE 1.0500 TO #TAB-REG(16)  /* PR */
MOVE 1.0700 TO #TAB-REG(17)  /* SC */
MOVE 1.0300 TO #TAB-REG(18)  /* RS */
MOVE 1.1500 TO #TAB-REG(19)  /* MS */
MOVE 1.2000 TO #TAB-REG(20)  /* MT */
MOVE 1.1800 TO #TAB-REG(21)  /* GO */
MOVE 1.2500 TO #TAB-REG(22)  /* TO */
MOVE 1.1000 TO #TAB-REG(23)  /* DF */
MOVE 1.2200 TO #TAB-REG(24)  /* RR */
MOVE 1.3300 TO #TAB-REG(25)  /* SE */
MOVE 1.0000 TO #TAB-REG(26)  /* RESERVED */
MOVE 1.0000 TO #TAB-REG(27)  /* RESERVED */
*
* INCOME BRACKETS - CEILING AND MULTIPLIER
MOVE 300.00  TO #FAIXA-RENDA(1)
MOVE 1.0000  TO #FATOR-FAIXA(1)
MOVE 600.00  TO #FAIXA-RENDA(2)
MOVE 0.8500  TO #FATOR-FAIXA(2)
MOVE 1000.00 TO #FAIXA-RENDA(3)
MOVE 0.7000  TO #FATOR-FAIXA(3)
MOVE 1500.00 TO #FAIXA-RENDA(4)
MOVE 0.5500  TO #FATOR-FAIXA(4)
MOVE 9999.99 TO #FAIXA-RENDA(5)
MOVE 0.4000  TO #FATOR-FAIXA(5)
*
* PARAMETER INPUT - VIA PDACALC
* TICKET 6210/2011 - CONVERTED FROM ONLINE PROGRAM TO
* SUBPROGRAM. THE CALL NOW COMES FROM BATCHPGT VIA CALLNAT.
* INPUT BLOCK BELOW DISABLED - DO NOT REMOVE (HISTORICAL)
*  INPUT 'SIFAP - BENEFIT CALCULATION' /
*        '=========================' /
*        'BENEFICIARY CPF.:' #CPF /
*        'PERIOD..........:' #COMPETENCIA '(YYYYMM)'
*
MOVE #PC-CPF         TO #CPF
MOVE #PC-COMPETENCIA TO #COMPETENCIA
RESET #PC-COD-RETORNO #PC-MSG
RESET #PC-VLR-BRUTO #PC-VLR-DESCONTO
RESET #PC-VLR-ABONO #PC-VLR-LIQUIDO
*
* EXTRACT MONTH/YEAR FROM PERIOD
COMPUTE #ANO = #COMPETENCIA / 100
COMPUTE #MES = #COMPETENCIA - (#ANO * 100)
*
IF #MES < 1 OR #MES > 12
  MOVE 2020 TO #PC-COD-RETORNO
  MOVE 'INVALID PERIOD' TO #PC-MSG
  ESCAPE ROUTINE
END-IF
*
* READ BENEFICIARY - FILE 150
MOVE EDITED #CPF (EM=99999999999) TO #CPF-STR
FIND BENEFICIARIO-V WITH NUM-CPF = #CPF-STR
  IF NO RECORDS FOUND
    MOVE 2001 TO #PC-COD-RETORNO
    MOVE 'BENEFICIARY NOT FOUND' TO #PC-MSG
    ESCAPE ROUTINE
  END-NOREC
  MOVE BENEFICIARIO-V.QTD-DEPENDENTES    TO #NUM-DEP
  MOVE BENEFICIARIO-V.COD-REGIAO         TO #COD-REG
  MOVE BENEFICIARIO-V.VLR-RENDA-FAMILIAR TO #RENDA
  MOVE BENEFICIARIO-V.DT-NASCIMENTO      TO #DT-NASC
  MOVE BENEFICIARIO-V.SIT-BENEFICIARIO   TO #STATUS-BENEF
  MOVE BENEFICIARIO-V.COD-PROGRAMA       TO #COD-PROG
END-FIND
*
IF #STATUS-BENEF NE 'A'
  MOVE 2002 TO #PC-COD-RETORNO
  COMPRESS 'BENEFICIARY NOT ACTIVE - STATUS:' #STATUS-BENEF
           INTO #PC-MSG
  ESCAPE ROUTINE
END-IF
*
* READ PROGRAM - FILE 155
FIND PROGRAMA-V WITH COD-PROGRAMA = #COD-PROG
  IF NO RECORDS FOUND
    MOVE 2003 TO #PC-COD-RETORNO
    MOVE 'PROGRAM NOT FOUND' TO #PC-MSG
    ESCAPE ROUTINE
  END-NOREC
  MOVE PROGRAMA-V.VLR-BASE-INDIVIDUAL TO #VLR-BASE
  MOVE PROGRAMA-V.TIPO-PROGRAMA       TO #TIPO-PROG
  MOVE PROGRAMA-V.FATOR-REAJUSTE      TO #FATOR-REAJ
END-FIND
*
* CALCULATE REGIONAL FACTOR
IF #COD-REG >= 1 AND #COD-REG <= 25
  MOVE #TAB-REG(#COD-REG) TO #FATOR-REG
ELSE
  MOVE 1.0000 TO #FATOR-REG
END-IF
*
* CALCULATE FAMILY FACTOR - ADDITION PER DEPENDENT
IF #NUM-DEP = 0
  MOVE 1.0000 TO #FATOR-FAM
ELSE
  IF #NUM-DEP <= 2
    COMPUTE #FATOR-FAM = 1.0000 + (#NUM-DEP * 0.0500)
  ELSE
    IF #NUM-DEP <= 4
      COMPUTE #FATOR-FAM = 1.1000 + ((#NUM-DEP - 2) * 0.0300)
    ELSE
      COMPUTE #FATOR-FAM = 1.1600 + ((#NUM-DEP - 4) * 0.0200)
    END-IF
  END-IF
END-IF
*
* CALCULATE INCOME FACTOR - DETERMINE BRACKET
PERFORM DET-FAIXA-RENDA
*
* CALCULATE AGE FACTOR
* --------------------------------------------------------
* Y2K - REMEDIATION 08/1998 - BUG2000 PROJECT
* TEAM: R.SOUZA / C.SILVA - TICKET 1998/0147
* UNTIL 07/1998, BIRTH DATE WAS READ AS YYMMDD AND THE
* CENTURY WAS DEDUCED USING THE WINDOW BELOW (PIVOT 50).
* THE FIELD CHANGED TO YYYYMMDD IN THE 08/1998 LOAD.
*    COMPUTE #AA = #DT-NASC / 10000
*    IF #AA < 50
*      COMPUTE #ANO-NASC = 2000 + #AA
*    ELSE
*      COMPUTE #ANO-NASC = 1900 + #AA
*    END-IF
* --------------------------------------------------------
COMPUTE #ANO-NASC = #DT-NASC / 10000
COMPUTE #IDADE = #ANO - #ANO-NASC
IF #IDADE >= 65
  MOVE 1.1500 TO #FATOR-IDADE
ELSE
  IF #IDADE >= 60
    MOVE 1.1000 TO #FATOR-IDADE
  ELSE
    IF #IDADE < 18
      MOVE 1.0500 TO #FATOR-IDADE
    ELSE
      MOVE 1.0000 TO #FATOR-IDADE
    END-IF
  END-IF
END-IF
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* MAIN CALCULATION - MONTHLY BENEFIT AMOUNT
* VLR = BASE * FATOR_REG * FATOR_FAM * FATOR_RND * FATOR_IDADE
* * * * * * * * * * * * * * * * * * * * * * * * * * * * *
COMPUTE #VLR-BENF = #VLR-BASE * #FATOR-REG * #FATOR-FAM
                     * #FATOR-RND * #FATOR-IDADE
*
* APPLY PROGRAM ADJUSTMENT
COMPUTE #VLR-BENF = #VLR-BENF * (1 + #FATOR-REAJ)
*
* TRUNCATE TO 2 DECIMAL PLACES - MAINFRAME STANDARD
COMPUTE #VLR-TEMP = #VLR-BENF * 100
COMPUTE #VLR-BENF = #VLR-TEMP / 100
*
MOVE #VLR-BENF TO #VLR-BRUTO
MOVE 'N' TO #TIPO-PGTO
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* CALCULATE 13TH SALARY - DECEMBER
* DIFFERENT FORMULA: VLR_13 = VLR_BASE * FATOR_REG * (ACTIVE_MONTHS/12)
* * * * * * * * * * * * * * * * * * * * * * * * * * * * *
IF #MES = 12
  MOVE 'D' TO #TIPO-PGTO
  COMPUTE #VLR-13 = #VLR-BASE * #FATOR-REG * #FATOR-IDADE
* TRUNCATE 13TH SALARY
  COMPUTE #VLR-TEMP = #VLR-13 * 100
  COMPUTE #VLR-13 = #VLR-TEMP / 100
  COMPUTE #VLR-BRUTO = #VLR-BENF + #VLR-13
*
* HOLIDAY BONUS - 15% ADDITION FOR TYPE 'A' PROGRAMS
  IF #TIPO-PROG = 'A'
    COMPUTE #VLR-ABONO = #VLR-BENF * 0.15
* TRUNCATE BONUS
    COMPUTE #VLR-TEMP = #VLR-ABONO * 100
    COMPUTE #VLR-ABONO = #VLR-TEMP / 100
    COMPUTE #VLR-BRUTO = #VLR-BRUTO + #VLR-ABONO
  ELSE
    MOVE 0 TO #VLR-ABONO
  END-IF
END-IF
*
* CALL DEDUCTION CALCULATION
PERFORM CALC-DESCONTOS
*
* CALCULATE NET AMOUNT
COMPUTE #VLR-LIQ = #VLR-BRUTO - #VLR-DESC
IF #VLR-LIQ < 0
  MOVE 0 TO #VLR-LIQ
END-IF
*
* TRUNCATE NET AMOUNT
COMPUTE #VLR-TEMP = #VLR-LIQ * 100
COMPUTE #VLR-LIQ = #VLR-TEMP / 100
*
* WRITE PAYMENT - FILE 160
MOVE #CPF-STR      TO PAGAMENTO-V.NUM-CPF
MOVE #COD-PROG     TO PAGAMENTO-V.COD-PROGRAMA
MOVE #COMPETENCIA  TO PAGAMENTO-V.ANO-MES-REF
MOVE #VLR-BRUTO    TO PAGAMENTO-V.VLR-BRUTO
MOVE #VLR-DESC     TO PAGAMENTO-V.VLR-DESCONTO-TOTAL
MOVE #VLR-LIQ      TO PAGAMENTO-V.VLR-LIQUIDO
MOVE #DT-HOJE      TO PAGAMENTO-V.DT-GERACAO
MOVE 'G'           TO PAGAMENTO-V.SIT-PAGAMENTO
MOVE #TIPO-PGTO    TO PAGAMENTO-V.TIPO-PAGAMENTO
MOVE #VLR-ABONO    TO PAGAMENTO-V.VLR-ABONO
STORE PAGAMENTO-V
END TRANSACTION
*
* RETURN AMOUNTS VIA PDACALC - TICKET 6210/2011
MOVE #VLR-BRUTO TO #PC-VLR-BRUTO
MOVE #VLR-DESC  TO #PC-VLR-DESCONTO
MOVE #VLR-ABONO TO #PC-VLR-ABONO
MOVE #VLR-LIQ   TO #PC-VLR-LIQUIDO
MOVE #TIPO-PGTO TO #PC-TIPO-PGTO
MOVE 0          TO #PC-COD-RETORNO
*
* SCREEN OUTPUT DISABLED DURING SUBPROGRAM CONVERSION
*  WRITE 'CALCULATION COMPLETED SUCCESSFULLY' /
*        '==============================' /
*        'CPF............:' #CPF /
*        'PERIOD.........:' #COMPETENCIA /
*        'GROSS AMOUNT...:' #VLR-BRUTO /
*        'DEDUCTION......:' #VLR-DESC /
*        'NET AMOUNT.....:' #VLR-LIQ /
*        'PAYMENT TYPE...:' #TIPO-PGTO
*  IF #MES = 12
*    WRITE '13TH SALARY AMT:' #VLR-13 /
*          'BONUS AMOUNT...:' #VLR-ABONO
*  END-IF
*
ESCAPE ROUTINE
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE DET-FAIXA-RENDA
  FOR #J = 1 TO 5
    IF #RENDA <= #FAIXA-RENDA(#J)
      MOVE #FATOR-FAIXA(#J) TO #FATOR-RND
      ESCAPE BOTTOM
    END-IF
  END-FOR
END-SUBROUTINE
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* CALCULATE DEDUCTIONS - SIMPLIFIED (SEE CALCDSCT FOR FULL VERSION)
DEFINE SUBROUTINE CALC-DESCONTOS
  MOVE 0 TO #VLR-DESC
* BASIC DEDUCTION - 3% SOCIAL CONTRIBUTION
  IF #VLR-BRUTO > 500.00
    COMPUTE #VLR-DESC = #VLR-BRUTO * 0.03
    COMPUTE #VLR-TEMP = #VLR-DESC * 100
    COMPUTE #VLR-DESC = #VLR-TEMP / 100
  END-IF
END-SUBROUTINE
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* NATURAL ERROR HANDLING - TICKET 7210
ON ERROR
  WRITE 'NATURAL ERROR' *ERROR-NR
        'LINE'          *ERROR-LINE
        'PGM'          *PROGRAM
  BACKOUT TRANSACTION
  TERMINATE 12
END-ERROR
*
END
