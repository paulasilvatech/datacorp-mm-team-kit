* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* COPYCODE: CCVALCPF
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   CARLOS ROBERTO DA SILVA
* DATE:     15/03/1997
* CHANGED:  17/05/2005 - MARCIA HELENA - ADD EQUAL-DIGIT CHECK
* CHANGED:  07/06/2011 - ROBERTO MENDES - DIVIDE WITH REMAINDER
* PURPOSE:  STANDARD CPF VALIDATION ROUTINE - MODULUS 11.
*           THIS IS THE SIFAP STANDARD VERSION (NT-SUPDE-014).
*           PROVIDES THE VALIDA-CPF-PADRAO SUBROUTINE.
*
* USE:      1. DECLARE REQUIRED FIELDS IN DEFINE DATA
*           2. MOVE THE CPF TO #CPF-STR
*           3. PERFORM VALIDA-CPF-PADRAO
*           4. TEST #CPF-OK
*           5. PLACE "INCLUDE CCVALCPF" AT THE END OF THE MODULE,
*              IN THE SUBROUTINE AREA, BEFORE "END"
*
* REQUIRED FIELDS IN THE INCLUDING MODULE'S DEFINE DATA:
*           1 #CPF-STR      (A11)       /* IN
*           1 #CPF-OK       (L)         /* OUT
*           1 #CPF-DIG      (N1/1:11)   /* WORK
*           1 #CPF-SOMA     (N5)        /* WORK
*           1 #CPF-QUOC     (N5)        /* WORK
*           1 #CPF-RESTO    (N2)        /* WORK
*           1 #CPF-DV1      (N1)        /* WORK
*           1 #CPF-DV2      (N1)        /* WORK
*           1 #CPF-PESO     (N2)        /* WORK
*           1 #CPF-IDX      (N2)        /* WORK
*           1 #CPF-IGUAIS   (L)         /* WORK
*
* NOTE:     INLINE COPIES OF THIS ROUTINE EXIST IN OTHER
*           SIFAP MODULES WITH DIFFERENT BEHAVIOR.
*           THE COPIES HAVE NOT BEEN REPLACED.
*           TICKET 6620/2011 - OPEN.
*           >>> DO NOT CHANGE THIS ROUTINE WITHOUT COMPARING THE
*           >>> COPIES - THEY ARE NOT EQUIVALENT.
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE VALIDA-CPF-PADRAO
*
  MOVE TRUE TO #CPF-OK
  RESET #CPF-SOMA #CPF-QUOC #CPF-RESTO #CPF-DV1 #CPF-DV2
*
* CPF MUST BE ENTIRELY NUMERIC
  IF #CPF-STR NE MASK(NNNNNNNNNNN)
    MOVE FALSE TO #CPF-OK
    ESCAPE ROUTINE
  END-IF
*
* EXTRACT THE 11 DIGITS
  FOR #CPF-IDX = 1 TO 11
    MOVE SUBSTR(#CPF-STR,#CPF-IDX,1) TO #CPF-DIG(#CPF-IDX)
  END-FOR
*
* REJECT CPF WITH ALL DIGITS EQUAL
  MOVE TRUE TO #CPF-IGUAIS
  FOR #CPF-IDX = 2 TO 11
    IF #CPF-DIG(#CPF-IDX) NE #CPF-DIG(1)
      MOVE FALSE TO #CPF-IGUAIS
      ESCAPE BOTTOM
    END-IF
  END-FOR
  IF #CPF-IGUAIS
    MOVE FALSE TO #CPF-OK
    ESCAPE ROUTINE
  END-IF
*
* FIRST CHECK DIGIT - WEIGHTS 10 TO 2
  MOVE 10 TO #CPF-PESO
  FOR #CPF-IDX = 1 TO 9
    COMPUTE #CPF-SOMA = #CPF-SOMA
                      + (#CPF-DIG(#CPF-IDX) * #CPF-PESO)
    SUBTRACT 1 FROM #CPF-PESO
  END-FOR
  DIVIDE 11 INTO #CPF-SOMA GIVING #CPF-QUOC
                           REMAINDER #CPF-RESTO
  IF #CPF-RESTO < 2
    MOVE 0 TO #CPF-DV1
  ELSE
    COMPUTE #CPF-DV1 = 11 - #CPF-RESTO
  END-IF
  IF #CPF-DV1 NE #CPF-DIG(10)
    MOVE FALSE TO #CPF-OK
    ESCAPE ROUTINE
  END-IF
*
* SECOND CHECK DIGIT - WEIGHTS 11 TO 2
  RESET #CPF-SOMA
  MOVE 11 TO #CPF-PESO
  FOR #CPF-IDX = 1 TO 10
    COMPUTE #CPF-SOMA = #CPF-SOMA
                      + (#CPF-DIG(#CPF-IDX) * #CPF-PESO)
    SUBTRACT 1 FROM #CPF-PESO
  END-FOR
  DIVIDE 11 INTO #CPF-SOMA GIVING #CPF-QUOC
                           REMAINDER #CPF-RESTO
  IF #CPF-RESTO < 2
    MOVE 0 TO #CPF-DV2
  ELSE
    COMPUTE #CPF-DV2 = 11 - #CPF-RESTO
  END-IF
  IF #CPF-DV2 NE #CPF-DIG(11)
    MOVE FALSE TO #CPF-OK
  END-IF
*
END-SUBROUTINE
