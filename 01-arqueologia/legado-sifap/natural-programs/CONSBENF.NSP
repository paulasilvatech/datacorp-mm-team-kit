* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* PROGRAM:  CONSBENF
* SYSTEM:   SIFAP - PAYMENT INSPECTION AND ADMINISTRATION SYSTEM
* AUTHOR:   MARCIA HELENA OLIVEIRA
* DATE:     28/09/1998
* CHANGED:  15/06/2003 - MARCIA HELENA - ADDED CPF MASK
* CHANGED:  22/11/2007 - ROBERTO MENDES - ADDED PAYMENT HISTORY
* CHANGED:  05/08/2012 - FERNANDA COSTA - ADJUSTED MAP SCREEN
* CHANGED:  09/04/2013 - ROBERTO MENDES - ADDED CALLNAT SUBVALCP
* CHANGED:  22/07/2016 - ANDERSON LIMA  - ADDED CCAUDIT TRAIL
* CHANGED:  30/05/2018 - PATRICIA GOMES - ALIGNED VIEW WITH DDM
* PURPOSE:  QUERY BENEFICIARY DATA - ONLINE 3270 SCREEN
*           DISPLAY REGISTRATION DATA AND PAYMENT HISTORY
*           USE MAP FOR SCREEN LAYOUT - FILES 150/160
* EXECUTION: ONLINE TRANSACTION - SIFAPPRD LIBRARY
*            NOT SCHEDULED IN SIFAPJ01/SIFAPJ02 (BATCH)
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
LOCAL USING PDAVALID
LOCAL USING LDASIFAP
LOCAL
  1 BENEFICIARIO-V VIEW OF BENEFICIARIO
    2 NUM-CPF            (A11)
    2 NOME-COMPLETO      (A60)
    2 DT-NASCIMENTO      (N8)
    2 SEXO               (A1)
    2 GRP-ENDERECO
      3 LOGRADOURO       (A60)
      3 NUMERO           (A10)
      3 BAIRRO           (A40)
      3 MUNICIPIO        (A40)
      3 UF               (A2)
      3 CEP              (N8)
      3 COD-REGIAO       (A2)
    2 SIT-BENEFICIARIO   (A1)
    2 COD-PROGRAMA       (A4)
    2 VLR-RENDA-FAMILIAR (P9,2)
    2 QTD-DEPENDENTES    (N2)
    2 NUM-NIS            (N11)
    2 DT-CADASTRO        (N8)
*
  1 PAGAMENTO-V VIEW OF PAGAMENTO
    2 NUM-PAGAMENTO      (N15)
    2 NUM-CPF            (A11)
    2 ANO-MES-REF        (N6)
    2 VLR-BRUTO          (P9,2)
    2 VLR-DESCONTO-TOTAL (P7,2)
    2 VLR-LIQUIDO        (P9,2)
    2 SIT-PAGAMENTO      (A1)
    2 TIPO-PAGAMENTO     (A1)
    2 DT-GERACAO         (N8)
*
* AUDIT TRAIL - FILE 153 - SEE COPYCODE CCAUDIT
  1 AUDITORIA-V VIEW OF AUDITORIA
    2 NUM-AUDITORIA      (N15)
    2 DT-EVENTO          (N8)
    2 HR-EVENTO          (N6)
    2 TS-EVENTO          (N14)
    2 COD-ACAO           (A2)
    2 COD-MODULO         (A8)
    2 DES-ACAO           (A80)
    2 TIPO-ENTIDADE      (A4)
    2 ID-ENTIDADE        (A15)
    2 NUM-CPF-AFETADO    (A11)
    2 USR-EVENTO         (A8)
    2 NOM-JOB-BATCH      (A16)
    2 SIT-BATCH          (A1)
*
  1 #CPF-BUSCA           (N11)
  1 #NIS-BUSCA           (N11)
  1 #TIPO-BUSCA          (A1)    /* C=CPF N=NIS */
  1 #CPF-A11             (A11)   /* FILE 150 KEY - DDM AB
  1 #CPF-MASK            (A14)
  1 #CPF-STR             (A11)
  1 #CPF-NUM             (N11)   /* CPF IN NUMERIC FORMAT
  1 #ENDERECO            (A80)
  1 #MSG                 (A60)
  1 #STATUS-DESC         (A15)
  1 #I                   (N3)
  1 #MAX-HIST            (N3)    /* OBSOLETE FIELD - UNTIL 2004
*
* AUDIT TRAIL FIELDS - REQUIRED BY CCAUDIT
  1 #AUD-ACAO            (A2)
  1 #AUD-ENTIDADE        (A4)
  1 #AUD-ID              (A15)
  1 #AUD-CPF             (A11)
  1 #AUD-DESCRICAO       (A80)
  1 #AUD-SEQ             (N15)
  1 #AUD-TIMN            (N7)
*
* PAYMENT HISTORY
  1 #HIST-COMP           (N6/1:12)
  1 #HIST-BRUTO          (P9,2/1:12)
  1 #HIST-LIQ            (P9,2/1:12)
  1 #HIST-STS            (A1/1:12)
  1 #HIST-TIPO           (A1/1:12)
  1 #QTD-HIST            (N3)
*
* CPF MASK
  1 #CPF-P1              (A3)
  1 #CPF-P2              (A3)
  1 #CPF-P3              (A3)
  1 #CPF-P4              (A2)
END-DEFINE
*
* ============================================
* ONLINE 3270 SCREEN - QUERY LOOP
* EXIT WITH PF3. MESSAGE ON THE LAST SCREEN LINE.
* ============================================
REPEAT
*
  SET CONTROL 'MB'
  INPUT USING MAP 'CONSBENF-M01'
*
* ALTERNATE SCREEN WITHOUT MAP
  IF *ERROR-NR NE 0
    INPUT 'SIFAP - BENEFICIARY QUERY' /
          '==========================' /
          'SEARCH TYPE (C=CPF / N=NIS):' #TIPO-BUSCA /
          'CPF..........:' #CPF-BUSCA /
          'NIS..........:' #NIS-BUSCA
  END-IF
*
  IF *PF-KEY = 'PF3'
    ESCAPE BOTTOM
  END-IF
*
  IF #TIPO-BUSCA = ' '
    MOVE 'C' TO #TIPO-BUSCA
  END-IF
*
* ============================================
* CPF VALIDATION BY CORPORATE ROUTINE
* TICKET 6620/2011 - SUBVALCP IS THE ONLY CPF CHECK
* ON THIS SCREEN. THERE IS NO INLINE ROUTINE HERE.
* ============================================
  IF #TIPO-BUSCA = 'C'
    MOVE 'C' TO #PV-TIPO-DOC
    MOVE EDITED #CPF-BUSCA (EM=99999999999) TO #PV-CPF
    RESET #PV-NIS
    CALLNAT 'SUBVALCP' #PV-TIPO-DOC #PV-CPF #PV-NIS
                       #PV-COD-RETORNO #PV-MSG
                       #PV-IND-ESPECIAL
    IF #PV-COD-RETORNO NE 0
      MOVE #PV-MSG TO #MSG
      REINPUT #MSG MARK *#CPF-BUSCA
    END-IF
    MOVE #PV-CPF TO #CPF-A11
  END-IF
*
* FIND BENEFICIARY - FILE 150
  DECIDE ON FIRST VALUE OF #TIPO-BUSCA
    VALUE 'C'
      FIND BENEFICIARIO-V WITH NUM-CPF = #CPF-A11
        IF NO RECORDS FOUND
          REINPUT 'BENEFICIARY NOT FOUND'
                  MARK *#CPF-BUSCA
        END-NOREC
        PERFORM EXIBE-BENEFICIARIO
      END-FIND
    VALUE 'N'
      FIND BENEFICIARIO-V WITH NUM-NIS = #NIS-BUSCA
        IF NO RECORDS FOUND
          REINPUT 'BENEFICIARY NOT FOUND'
                  MARK *#NIS-BUSCA
        END-NOREC
        PERFORM EXIBE-BENEFICIARIO
      END-FIND
    NONE
      REINPUT 'INVALID SEARCH TYPE' MARK *#TIPO-BUSCA
  END-DECIDE
*
* ============================================
* PERSONAL DATA ACCESS TRAIL
* IN-TCU 63/2010 - TICKET 8842/2016
* ============================================
  MOVE 'CO'     TO #AUD-ACAO
  MOVE 'BENF'   TO #AUD-ENTIDADE
  MOVE #CPF-A11 TO #AUD-ID
  MOVE #CPF-A11 TO #AUD-CPF
  MOVE 'BENEFICIARY REGISTRATION QUERY - CONSBENF'
       TO #AUD-DESCRICAO
  PERFORM GRAVA-AUDITORIA
  END TRANSACTION
*
END-REPEAT
*
* ============================================
* NATURAL ERROR HANDLING - TICKET 5512/2005
* ESCAPE ROUTINE RETURNS CONTROL TO THE INSTRUCTION
* FOLLOWING THE ONE THAT CAUSED THE ERROR.
* ============================================
ON ERROR
  WRITE 'NATURAL ERROR:' *ERROR-NR
        'LINE:' *ERROR-LINE
        'PGM:' *PROGRAM
  ESCAPE ROUTINE
END-ERROR
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* DISPLAY REGISTRATION AND HISTORY. RUN INSIDE THE FIND
* BLOCK, WHERE THE FILE 150 RECORD BUFFER IS GUARANTEED.
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE EXIBE-BENEFICIARIO
*
* CPF MASK - HIDE SENSITIVE DATA
  MOVE BENEFICIARIO-V.NUM-CPF TO #CPF-A11
  MOVE BENEFICIARIO-V.NUM-CPF TO #CPF-STR
  MOVE EDITED #CPF-STR TO #CPF-NUM (EM=99999999999)
  PERFORM MASCARA-CPF
*
* ADDRESS - BUILT FROM THE BA GROUP IN FILE 150
  COMPRESS BENEFICIARIO-V.LOGRADOURO ','
           BENEFICIARIO-V.NUMERO '-'
           BENEFICIARIO-V.BAIRRO INTO #ENDERECO
*
* ============================================
* Y2K - REMEDIATION 08/1998 - BUG2000 PROJECT
* TEAM R.SOUZA - TICKET 1180/1998
* UNTIL 07/1998 THE BIRTH DATE ARRIVED AS YYMMDD AND
* WAS EXPANDED BY THE CENTURY WINDOW BELOW. THE FIELD
* CHANGED TO YYYYMMDD IN FILE 150 AND THE BLOCK WAS
* DISABLED - DO NOT REMOVE (HISTORICAL).
*   MOVE #L-AA-CURTO TO #L-ANO-EXPANDIDO
*   IF #L-AA-CURTO < #L-SEC-JANELA
*     COMPUTE #L-ANO-EXPANDIDO = 2000 + #L-AA-CURTO
*   ELSE
*     COMPUTE #L-ANO-EXPANDIDO = 1900 + #L-AA-CURTO
*   END-IF
* ============================================
*
* STATUS DESCRIPTION
  DECIDE ON FIRST VALUE OF BENEFICIARIO-V.SIT-BENEFICIARIO
    VALUE 'A'
      MOVE 'ACTIVE' TO #STATUS-DESC
    VALUE 'S'
      MOVE 'SUSPENDED' TO #STATUS-DESC
    VALUE 'C'
      MOVE 'CANCELED' TO #STATUS-DESC
    VALUE 'I'
      MOVE 'INACTIVE' TO #STATUS-DESC
    VALUE 'D'
      MOVE 'TERMINATED' TO #STATUS-DESC
    NONE
      MOVE 'UNKNOWN' TO #STATUS-DESC
  END-DECIDE
*
* DISPLAY REGISTRATION DATA
  WRITE 'SIFAP - BENEFICIARY INFORMATION' /
        '================================' /
        'CPF...........:' #CPF-MASK /
        'NAME..........:' BENEFICIARIO-V.NOME-COMPLETO /
        'BIRTH DATE....:' BENEFICIARIO-V.DT-NASCIMENTO /
        'SEX...........:' BENEFICIARIO-V.SEXO /
        'ADDRESS.......:' #ENDERECO /
        'CITY/STATE....:' BENEFICIARIO-V.MUNICIPIO
                      '/' BENEFICIARIO-V.UF /
        'ZIP CODE......:' BENEFICIARIO-V.CEP /
        'STATUS........:' BENEFICIARIO-V.SIT-BENEFICIARIO
                      '-' #STATUS-DESC /
        'PROGRAM CODE..:' BENEFICIARIO-V.COD-PROGRAMA /
        'FAMILY INCOME.:' BENEFICIARIO-V.VLR-RENDA-FAMILIAR /
        'DEPENDENTS....:' BENEFICIARIO-V.QTD-DEPENDENTES /
        'REGION........:' BENEFICIARIO-V.COD-REGIAO /
        'NIS...........:' BENEFICIARIO-V.NUM-NIS /
        'REGISTRATION..:' BENEFICIARIO-V.DT-CADASTRO
*
* PAYMENT HISTORY - LAST 12
  WRITE ' ' /
        'PAYMENT HISTORY (LAST 12)' /
        '========================='
  WRITE 'PERIOD        GROSS        NET          STS  TYPE'
  WRITE '----------    -----------  -----------  ---  ----'
*
  MOVE 0 TO #QTD-HIST
  READ PAGAMENTO-V BY NUM-CPF = BENEFICIARIO-V.NUM-CPF
    IF PAGAMENTO-V.NUM-CPF NE BENEFICIARIO-V.NUM-CPF
      ESCAPE BOTTOM
    END-IF
    ADD 1 TO #QTD-HIST
    IF #QTD-HIST > 12
      ESCAPE BOTTOM
    END-IF
    WRITE PAGAMENTO-V.ANO-MES-REF '    '
          PAGAMENTO-V.VLR-BRUTO '  '
          PAGAMENTO-V.VLR-LIQUIDO '  '
          PAGAMENTO-V.SIT-PAGAMENTO '    '
          PAGAMENTO-V.TIPO-PAGAMENTO
  END-READ
*
  IF #QTD-HIST = 0
    WRITE 'NO PAYMENTS FOUND'
  END-IF
*
END-SUBROUTINE
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* CPF MASK - FORMAT ***.***.XXX-XX
* NOTE: KNOWN INCONSISTENCY - SOMETIMES SHOWS THE FIRST 3 DIGITS
*       INSTEAD OF THE LAST ONES. DEPENDS ON THE STORED CPF LENGTH.
*       DO NOT CORRECT WITHOUT AUDIT APPROVAL.
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE MASCARA-CPF
  IF #CPF-NUM < 10000000000
* CPF WITH FEWER THAN 11 DIGITS (LEFT-PADDED WITH ZEROS)
    MOVE SUBSTR(#CPF-STR,1,3) TO #CPF-P1
    COMPRESS #CPF-P1 '.***.' '***-**' INTO #CPF-MASK LEAVING NO SPACE
  ELSE
    MOVE '***' TO #CPF-P1
    MOVE '***' TO #CPF-P2
    MOVE SUBSTR(#CPF-STR,7,3) TO #CPF-P3
    MOVE SUBSTR(#CPF-STR,10,2) TO #CPF-P4
    COMPRESS #CPF-P1 '.' #CPF-P2 '.' #CPF-P3 '-' #CPF-P4
        INTO #CPF-MASK LEAVING NO SPACE
  END-IF
END-SUBROUTINE
*
* AUDIT TRAIL - FILE 153
INCLUDE CCAUDIT
*
END
