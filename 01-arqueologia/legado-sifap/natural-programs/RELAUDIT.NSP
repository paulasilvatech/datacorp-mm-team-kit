* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
* PROGRAMA: RELAUDIT
* SISTEMA:  SIFAP - SIST. FISC. ADM. PAGAMENTOS
* AUTOR:    ROBERTO MENDES JUNIOR
* DATA:     20/08/2002
* ALTERADO: 12/12/2006 - ROBERTO MENDES - INC FILTROS
* ALTERADO: 30/04/2011 - ANDERSON LIMA  - AJUSTE FORMATO
* ALTERADO: 15/09/2014 - FERNANDA COSTA - LIMPEZA RELATORIO
* ALTERADO: 18/06/2017 - PATRICIA GOMES - IMPRESSORA LOGICA 1
* ALTERADO: 30/05/2018 - PATRICIA GOMES - ALINHA VIEW AO DDM
* OBJETIVO: RELATORIO TRILHA AUDITORIA DO SISTEMA
*           LISTAGEM EVENTOS C/ FILTROS POR PERIODO/ACAO
*           SAIDA IMPRESSORA/TELA - ARQ 170
* EXECUCAO: SOB DEMANDA - NAO AGENDADO EM SIFAPJ02.
*           P/ SAIDA=I O JOB DEVE ALOCAR O DD CMPRT01
*           NO MESMO PADRAO DO SIFAPJ02 (LRECL=133).
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE DATA
LOCAL USING LDASIFAP
LOCAL
  1 AUDITORIA-V VIEW OF AUDITORIA
    2 NUM-AUDITORIA      (N15)
    2 DT-EVENTO          (N8)
    2 HR-EVENTO          (N6)
    2 USR-EVENTO         (A8)
    2 COD-ACAO           (A2)
    2 TIPO-ENTIDADE      (A4)
    2 ID-ENTIDADE        (A15)
    2 VLR-ANTERIOR       (A60)
    2 VLR-NOVO           (A60)
    2 DES-ACAO           (A80)
*
  1 #DT-INI              (N8)
  1 #DT-FIM              (N8)
  1 #ACAO-FILTRO         (A2)
  1 #USUARIO-FILTRO      (A8)
  1 #TABELA-FILTRO       (A4)
  1 #DT-HOJE             (N8)
  1 #TIPO-SAIDA          (A1)   /* T=TELA I=IMPRESSORA */
*
* CONTADORES
  1 #QTD-TOTAL           (N8)
  1 #QTD-EXIBIDOS        (N8)
  1 #QTD-FILTRADOS       (N8)
  1 #QTD-DIA             (N8)
*
* CONTADORES POR ACAO
  1 #QTD-INCLUSAO        (N8)
  1 #QTD-ALTERACAO       (N8)
  1 #QTD-CONSULTA        (N8)
  1 #QTD-CONCILIACAO     (N8)
  1 #QTD-DIVERGENCIA     (N8)
  1 #QTD-OUTROS          (N8)
*
  1 #PAG                 (N4)
  1 #LINHA               (N2)
  1 #MAX-LINHAS          (N2)
  1 #I                   (N2)
  1 #ACAO-DESC           (A20)
  1 #HR-FORMAT           (A8)
  1 #HR-STR              (A6)
*
* LINHAS SEPARADORAS DE IMPRESSAO
  1 #SEP-100             (A100)
  1 #SEP-120             (A120)
END-DEFINE
*
* IMPRESSORA LOGICA 1 - SO E USADA QUANDO SAIDA = I
DEFINE PRINTER (1) OUTPUT 'CMPRT01'
FORMAT (1) PS=66 LS=132
*
MOVE *DATN TO #DT-HOJE
MOVE 66 TO #MAX-LINHAS
MOVE 0 TO #PAG
MOVE 99 TO #LINHA
MOVE 0 TO #QTD-TOTAL
MOVE 0 TO #QTD-EXIBIDOS
MOVE 0 TO #QTD-FILTRADOS
MOVE 0 TO #QTD-DIA
MOVE 0 TO #QTD-INCLUSAO
MOVE 0 TO #QTD-ALTERACAO
MOVE 0 TO #QTD-CONSULTA
MOVE 0 TO #QTD-CONCILIACAO
MOVE 0 TO #QTD-DIVERGENCIA
MOVE 0 TO #QTD-OUTROS
*
MOVE ALL '-' TO #SEP-100
MOVE ALL '-' TO #SEP-120
*
INPUT 'SIFAP - RELATORIO AUDITORIA' /
      '============================' /
      'DATA INICIAL.....:' #DT-INI /
      'DATA FINAL.......:' #DT-FIM /
      'ACAO (BRANCO=TODAS):' #ACAO-FILTRO /
      'USUARIO (BRANCO=TODOS):' #USUARIO-FILTRO /
      'TABELA (BRANCO=TODAS):' #TABELA-FILTRO /
      'SAIDA (T=TELA I=IMPR):' #TIPO-SAIDA
*
IF #TIPO-SAIDA = ' '
  MOVE 'T' TO #TIPO-SAIDA
END-IF
*
IF #DT-INI = 0
  MOVE 19970101 TO #DT-INI
END-IF
IF #DT-FIM = 0
  MOVE #DT-HOJE TO #DT-FIM
END-IF
*
* PROCESSAMENTO
READ AUDITORIA-V BY DT-EVENTO STARTING FROM #DT-INI
     THRU #DT-FIM
*
  AT START OF DATA
    RESET #QTD-TOTAL #QTD-EXIBIDOS #QTD-FILTRADOS #QTD-DIA
  END-START
*
  IF AUDITORIA-V.DT-EVENTO < #DT-INI
    ESCAPE TOP
  END-IF
  IF AUDITORIA-V.DT-EVENTO > #DT-FIM
    ESCAPE BOTTOM
  END-IF
*
  ADD 1 TO #QTD-TOTAL
*
* ============================================
* FILTRO ACAO - EXCLUSOES NAO SAO EXIBIDAS
* ============================================
  IF AUDITORIA-V.COD-ACAO = 'EX'
    ADD 1 TO #QTD-FILTRADOS
    ESCAPE TOP
  END-IF
*
* FILTRO ACAO (SE INFORMADO)
  IF #ACAO-FILTRO NE ' '
    IF AUDITORIA-V.COD-ACAO NE #ACAO-FILTRO
      ADD 1 TO #QTD-FILTRADOS
      ESCAPE TOP
    END-IF
  END-IF
*
* FILTRO USUARIO (SE INFORMADO)
  IF #USUARIO-FILTRO NE ' '
    IF AUDITORIA-V.USR-EVENTO NE #USUARIO-FILTRO
      ADD 1 TO #QTD-FILTRADOS
      ESCAPE TOP
    END-IF
  END-IF
*
* FILTRO TABELA (SE INFORMADO)
  IF #TABELA-FILTRO NE ' '
    IF AUDITORIA-V.TIPO-ENTIDADE NE #TABELA-FILTRO
      ADD 1 TO #QTD-FILTRADOS
      ESCAPE TOP
    END-IF
  END-IF
*
  ADD 1 TO #QTD-EXIBIDOS
  ADD 1 TO #QTD-DIA
*
* CONTADORES POR TIPO ACAO
  DECIDE ON FIRST VALUE OF AUDITORIA-V.COD-ACAO
    VALUE 'IN'
      ADD 1 TO #QTD-INCLUSAO
      MOVE 'INCLUSAO' TO #ACAO-DESC
    VALUE 'AL'
      ADD 1 TO #QTD-ALTERACAO
      MOVE 'ALTERACAO' TO #ACAO-DESC
    VALUE 'CO'
      ADD 1 TO #QTD-CONCILIACAO
      MOVE 'CONCILIACAO' TO #ACAO-DESC
    VALUE 'CN'
      ADD 1 TO #QTD-CONSULTA
      MOVE 'CONSULTA' TO #ACAO-DESC
    VALUE 'DV'
      ADD 1 TO #QTD-DIVERGENCIA
      MOVE 'DIVERGENCIA' TO #ACAO-DESC
    NONE
      ADD 1 TO #QTD-OUTROS
      MOVE 'OUTRA' TO #ACAO-DESC
  END-DECIDE
*
* FORMATAR HORA
  MOVE EDITED AUDITORIA-V.HR-EVENTO (EM=999999) TO #HR-STR
  COMPRESS SUBSTR(#HR-STR,1,2) ':' SUBSTR(#HR-STR,3,2) ':'
           SUBSTR(#HR-STR,5,2) INTO #HR-FORMAT LEAVING NO SPACE
*
* PAGINACAO
  IF #LINHA >= (#MAX-LINHAS - 5)
    PERFORM IMPRIME-CAB-AUDIT
  END-IF
*
* IMPRIMIR DETALHE
  IF #TIPO-SAIDA = 'T'
    WRITE AUDITORIA-V.DT-EVENTO ' '
          #HR-FORMAT ' '
          AUDITORIA-V.USR-EVENTO ' '
          #ACAO-DESC ' '
          AUDITORIA-V.TIPO-ENTIDADE ' '
          AUDITORIA-V.ID-ENTIDADE
  ELSE
    WRITE (1) AUDITORIA-V.DT-EVENTO ' '
          #HR-FORMAT ' '
          AUDITORIA-V.USR-EVENTO ' '
          #ACAO-DESC ' '
          AUDITORIA-V.TIPO-ENTIDADE ' '
          AUDITORIA-V.ID-ENTIDADE ' '
          AUDITORIA-V.DES-ACAO
  END-IF
  ADD 1 TO #LINHA
*
* QUEBRA DE CONTROLE POR DIA - CHAMADO 7734/2017
* SUBTOTAL SO NA IMPRESSORA P/ NAO ALTERAR A TELA
  AT BREAK OF AUDITORIA-V.DT-EVENTO
    IF #TIPO-SAIDA NE 'T'
      WRITE (1) '   SUBTOTAL DIA' OLD(AUDITORIA-V.DT-EVENTO)
                ':' #QTD-DIA 'EVENTOS'
      ADD 1 TO #LINHA
    END-IF
    MOVE 0 TO #QTD-DIA
  END-BREAK
*
* TOTAL GERAL DA IMPRESSORA
  AT END OF DATA
    IF #TIPO-SAIDA NE 'T'
      WRITE (1) #SEP-120
      WRITE (1) 'TOTAL DE EVENTOS EXIBIDOS:' #QTD-EXIBIDOS
    END-IF
  END-ENDDATA
*
END-READ
*
* RESUMO
WRITE ' ' /
      '====================================' /
      'RESUMO AUDITORIA' /
      '====================================' /
      'TOTAL REGISTROS....:' #QTD-TOTAL /
      'EXIBIDOS...........:' #QTD-EXIBIDOS /
      'FILTRADOS..........:' #QTD-FILTRADOS /
      ' ' /
      'POR TIPO ACAO:' /
      '  INCLUSOES........:' #QTD-INCLUSAO /
      '  ALTERACOES.......:' #QTD-ALTERACAO /
      '  CONSULTAS........:' #QTD-CONSULTA /
      '  CONCILIACOES.....:' #QTD-CONCILIACAO /
      '  DIVERGENCIAS.....:' #QTD-DIVERGENCIA /
      '  OUTRAS...........:' #QTD-OUTROS /
      '===================================='
*
* ============================================
* DISTRIBUICAO DE EVENTOS POR DIA (HISTOGRAM)
* SOMENTE NA IMPRESSORA - CHAMADO 7734/2017
* ============================================
IF #TIPO-SAIDA NE 'T'
  WRITE (1) ' '
  WRITE (1) 'DISTRIBUICAO DE EVENTOS POR DIA'
  WRITE (1) #SEP-100
  HISTOGRAM AUDITORIA-V FOR DT-EVENTO
            STARTING FROM #DT-INI THRU #DT-FIM
    WRITE (1) 'DATA:' AUDITORIA-V.DT-EVENTO
              '  OCORRENCIAS:' *NUMBER
  END-HISTOGRAM
  WRITE (1) #SEP-100
END-IF
*
* ============================================
* TRATAMENTO DE ERRO NATURAL - CHAMADO 5512/2005
* ============================================
ON ERROR
  WRITE 'ERRO NATURAL:' *ERROR-NR
        'LINHA:' *ERROR-LINE
        'PGM:' *PROGRAM
  TERMINATE 12
END-ERROR
*
* * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * *
DEFINE SUBROUTINE IMPRIME-CAB-AUDIT
  ADD 1 TO #PAG
  IF #TIPO-SAIDA = 'T'
    WRITE '/'
    WRITE 'SIFAP - TRILHA DE AUDITORIA'
          40X 'PAG:' #PAG
    WRITE 'PERIODO:' #DT-INI 'A' #DT-FIM
          40X 'DATA:' #DT-HOJE
    WRITE #SEP-100
    WRITE 'DATA       HORA     USUARIO  ACAO'
          20X 'TABELA          CHAVE'
    WRITE #SEP-100
  ELSE
    NEWPAGE (1)
    WRITE (1) NOTITLE 'SIFAP - TRILHA DE AUDITORIA'
          40X 'PAG:' #PAG
    WRITE (1) 'PERIODO:' #DT-INI 'A' #DT-FIM
          40X 'DATA:' #DT-HOJE
    WRITE (1) #SEP-120
    WRITE (1) 'DATA       HORA     USUARIO  ACAO'
          20X 'TABELA          CHAVE               DESCRICAO'
    WRITE (1) #SEP-120
  END-IF
  MOVE 7 TO #LINHA
END-SUBROUTINE
*
END
