//*==================================================================
//* JOB......: SIFAPJ01
//* SISTEMA..: SIFAP - SIST. FISC. ADM. PAGAMENTOS
//* PDS......: SIFAP.PROD.JCLLIB(SIFAPJ01)
//* AUTOR....: CARLOS ROBERTO DA SILVA
//* DATA.....: 22/06/1997
//* ALTERADO.: 15/01/2000 - CARLOS SILVA   - OTIMIZ ORD CPF
//* ALTERADO.: 30/08/2004 - PATRICIA GOMES - INC STEP LOG ERROS
//* ALTERADO.: 25/05/2012 - FERNANDA COSTA - COMPETENCIA POR PARM
//* ALTERADO.: 10/07/2015 - ANDERSON LIMA  - INC TRILHA AUDITORIA
//* OBJETIVO.: FOLHA MENSAL DE PAGAMENTO - EXECUTA BATCHPGT
//*==================================================================
//* AGENDAMENTO (CONTROL-M)
//*   TABELA........: SIFAP-MENSAL
//*   JOB NAME......: SIFAPJ01
//*   GRUPO.........: SIFAP-PGT
//*   PERIODICIDADE.: MENSAL - 1O DIA UTIL
//*   HORARIO.......: 22:00  JANELA 4H
//*   PREDECESSOR...: NENHUM
//*   SUCESSOR......: SIFAPJ02 (COND RC=0)
//*   CONDICAO OUT..: SIFAP-PGT-OK ODAT
//*   RECURSO.......: ADABAS-057 (QTD 1)
//*==================================================================
//* RESTART
//*   STEP010 E REINICIAVEL. O BATCHPGT VERIFICA SE JA EXISTE
//*   PAGAMENTO GERADO P/ A COMPETENCIA E NAO DUPLICA.
//*   EM CASO DE ABEND:
//*     1. CONFERIR RC E CMPRINT
//*     2. CONFIRMAR QUE CMWKF01 FOI DESALOCADO
//*     3. REEXECUTAR A PARTIR DE STEP010 COM A MESMA
//*        COMPETENCIA INFORMADA EM CMSYNIN
//*   NAO REEXECUTAR COM COMPETENCIA DIFERENTE SEM ABRIR
//*   CHAMADO - VER ITSM-SIFAP-002.
//*==================================================================
//SIFAPJ01 JOB (SIFAP,DESIF),'FOLHA MENSAL SIFAP',
//             CLASS=B,MSGCLASS=X,MSGLEVEL=(1,1),
//             REGION=0M,TIME=1440,NOTIFY=&SYSUID
//*
//JOBLIB   DD DSN=SIFAP.PROD.LOADLIB,DISP=SHR
//         DD DSN=SAG.NAT426.LOAD,DISP=SHR
//         DD DSN=SAG.ADA614.LOAD,DISP=SHR
//*
//*------------------------------------------------------------------
//* STEP010 - GERACAO DA FOLHA (BATCHPGT)
//*------------------------------------------------------------------
//STEP010  EXEC PGM=NATBATCH,
//             PARM='IM=D,MADIO=0,MT=0,MAXCL=0,DBID=57,FNR=150'
//STEPLIB  DD DSN=SAG.NAT426.LOAD,DISP=SHR
//         DD DSN=SAG.ADA614.LOAD,DISP=SHR
//DDCARD   DD DSN=SIFAP.PROD.PARMLIB(ADAPARM),DISP=SHR
//CMPRINT  DD SYSOUT=*
//*
//* CMWKF01 - EXTRACAO DE PAGAMENTOS P/ REMESSA BANCARIA
//CMWKF01  DD DSN=SIFAP.PROD.PGTO.EXTRACT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(500,100),RLSE),
//            DCB=(RECFM=FB,LRECL=240,BLKSIZE=27840)
//*
//* CMWKF02 - LOG DE REJEITADOS (CHAMADO 4180/2004)
//CMWKF02  DD DSN=SIFAP.PROD.PGTO.REJEIT(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(20,10),RLSE),
//            DCB=(RECFM=FB,LRECL=120,BLKSIZE=27840)
//*
//* CMSYNIN - ENTRADA DE COMANDOS NATURAL
//* LINHA 3 = COMPETENCIA AAAAMM LIDA PELO BATCHPGT
//* ANTES DE 05/2012 O PROGRAMA DERIVAVA A COMPETENCIA DE
//* *DATN E NAO ACEITAVA REPROCESSAMENTO - CHAMADO 5980
//CMSYNIN  DD *
LOGON SIFAPPRD
BATCHPGT
202601
FIN
/*
//*
//*------------------------------------------------------------------
//* STEP020 - COPIA DA REMESSA P/ AREA DE TRANSMISSAO
//* SO EXECUTA SE STEP010 TERMINOU COM RC MENOR OU IGUAL A 4
//*------------------------------------------------------------------
//STEP020  EXEC PGM=IEBGENER,COND=(4,LT,STEP010)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=SIFAP.PROD.PGTO.EXTRACT(0),DISP=SHR
//SYSUT2   DD DSN=SIFAP.TRANSM.REMESSA(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(500,100),RLSE),
//            DCB=(RECFM=FB,LRECL=240,BLKSIZE=27840)
//*
//*------------------------------------------------------------------
//* STEP030 - AVISO DE FALHA (SO EXECUTA SE STEP010 FALHOU)
//*------------------------------------------------------------------
//STEP030  EXEC PGM=IEFBR14,COND=(5,GT,STEP010)
//AVISO    DD DSN=SIFAP.PROD.ALERTA.PGTO,DISP=SHR
//*
//*==================================================================
//* CODIGOS DE RETORNO ESPERADOS DO STEP010
//*   RC=0  - FOLHA GERADA SEM REJEITADOS
//*   RC=4  - FOLHA GERADA COM REJEITADOS EM CMWKF02
//*   RC=8  - COMPETENCIA JA PROCESSADA - NADA A FAZER
//*   RC=12 - ERRO NATURAL - VER CMPRINT E ACIONAR PLANTAO
//*==================================================================
