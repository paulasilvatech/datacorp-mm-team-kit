# Copy to terraform.tfvars and adjust before running terraform apply.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is gitignored because allowed_source_cidrs contains real
# participant IP addresses. NOTHING SECRET BELONGS IN THIS FILE either way:
# the Adabas password is generated by Terraform and stored in Key Vault, and
# Azure credentials come from `az login` or the workflow's OIDC token.

# ---------------------------------------------------------------------------
# Before you start: pick the subscription
# ---------------------------------------------------------------------------
# The subscription is NOT a Terraform variable. The azurerm provider reads it from
# the environment, and an unset ARM_SUBSCRIPTION_ID is the most common "it planned
# against the wrong account" mistake.
#
#   az login
#   az account show --query id -o tsv          # the id you want
#   export ARM_SUBSCRIPTION_ID="<SUBSCRIPTION-ID>"
#
# Then confirm you actually have quota in the target region. A vCPU quota of zero
# is what left the previous attempt half-applied, with a resource group and a Key
# Vault created and no VM:
#
#   az vm list-usage --location eastus2 -o table | grep -i 'Standard DSv3'
#
# And confirm the remote state backend exists (infra/bootstrap), then:
#
#   terraform init \
#     -backend-config="resource_group_name=<TFSTATE-RG>" \
#     -backend-config="storage_account_name=<TFSTATE-ACCOUNT>"

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

owner = "your-github-handle"

# Every address that needs to reach the lab, in CIDR form.
# Discover your own with: curl -s https://api.ipify.org
# Validation rejects 0.0.0.0/0, *, ::/0, "Internet"/"Any" and any prefix wider than /8,
# on purpose: Adabas CE has no channel encryption and the Natural Development Server has
# no strong authentication, so an internet-facing listener is a direct compromise path.
# Entries must be explicit IPv4 CIDRs with a /8../32 prefix (Azure service tags are refused).
#
# This list also gates the HTTPS demo URL. To let an audience in, add their ranges here
# rather than reaching for enable_public_acme.
allowed_source_cidrs = [
  "203.0.113.10/32",
]

# ---------------------------------------------------------------------------
# Strongly recommended
# ---------------------------------------------------------------------------

# Warned 30 minutes before the daily auto-shutdown, and copied on every budget alert.
# Without it, the first signal that the lab shut down mid-demo - or burned through its
# budget - is somebody noticing.
# auto_shutdown_notification_email = "you@example.com"

# Monthly spend cap for the lab resource group, in the subscription's billing currency.
# Alerts fire at 50% and 80% of actual spend and at 100% of forecast spend. A budget
# notifies; it does not stop anything.
# monthly_budget_amount = 100

# ---------------------------------------------------------------------------
# Region and naming
# ---------------------------------------------------------------------------

# The demo FQDN is <label>.<location>.cloudapp.azure.com, so changing the region
# changes the URL. location_short is derived from location; override it only for a
# region missing from the map in main.tf.
# location       = "eastus2"
# location_short = "eus2"

# Public DNS label. Leave unset to derive "<project>-<environment>-<random>", which is
# what keeps it globally unique inside the region.
# dns_label_prefix = "sifap-demo-2026"

# project     = "sifap"
# environment = "lab"

# ---------------------------------------------------------------------------
# The public demo URL and TLS
# ---------------------------------------------------------------------------

# false (default): 80/443 open only to allowed_source_cidrs, and Caddy signs the
#   certificate with its own local CA. https:// works and is encrypted, but a browser
#   warns until you trust that root (see the trust_demo_ca_command output).
#
# true: 80/443 open to the "Internet" service tag so Let's Encrypt can complete the
#   ACME HTTP-01 challenge, producing a publicly trusted certificate with no warning.
#   READ THE TRADEOFF FIRST - README.md -> "TLS on the demo URL". Validation arrives
#   from arbitrary addresses worldwide, so a trusted certificate and an allow-listed
#   port 80 are mutually exclusive. Only Caddy is exposed; SSH, NDV and ADATCP stay
#   on the allow-list.
# enable_public_acme = true
# acme_contact_email = "you@example.com"   # required when enable_public_acme = true

# Opens plaintext port 8190 straight to the Adabas console, for the allow-list only.
# Off by default: the console is served over TLS at the demo URL, so this is a
# fallback for when the proxy itself is what broke.
# expose_adabas_admin_port = true

# ---------------------------------------------------------------------------
# Sizing and workload
# ---------------------------------------------------------------------------

# 2 vCPU / 8 GB is the practical floor for Adabas CE and Natural CE together.
# vm_size = "Standard_D2s_v3"

# Premium SSD holding the Adabas database containers, mounted at /mnt/adabas-data.
# 32 GB fits the demo database with room to load the SIFAP corpus; raise it before a
# large CATALL, because growing it later needs a VM restart.
# data_disk_size_gb = 32

# Adabas database id that Natural maps through dbmapping. The Natural CE image ships a
# mapping hardcoded to DBIDs 11 and 12; cloud-init replaces it with one built from this
# value, so any id from 1 to 65535 works - but 12 matches the demo database the image
# creates, so change it only if you know why.
# adabas_dbid = 12

# ssh_public_key_path = "~/.ssh/id_rsa.pub"
# admin_username      = "sifapadmin"

# TODO(pin): "latest" is not reproducible. Resolve an exact version against your own
# subscription and paste it here so a rebuild boots the same image:
#   az vm image list --publisher Canonical --offer 0001-com-ubuntu-server-jammy \
#     --sku 22_04-lts-gen2 --all --query "[-5:].version" -o table
# source_image_version = "22.04.202501150"

# ---------------------------------------------------------------------------
# Cost control
# ---------------------------------------------------------------------------

# auto_shutdown_time     = "2000"
# auto_shutdown_timezone = "Eastern Standard Time"

# First day of the month the budget starts tracking. Empty derives the current month.
# budget_start_date = "2026-09-01T00:00:00Z"

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# log_retention_days = 30
# log_daily_quota_gb = 1     # -1 removes the cap

# ---------------------------------------------------------------------------
# Data protection
# ---------------------------------------------------------------------------

# Set before a destructive experiment, apply, and an incremental snapshot of the Adabas
# data disk is created and tracked in state:
#   terraform apply -var 'data_disk_snapshot_label=before-catall'
# data_disk_snapshot_label = "before-catall"
